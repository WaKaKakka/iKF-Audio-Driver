    <!--Img Compressor-->
    <!--RadioButton Compressor-->
    <Style x:Key="RadioButton_Compressor" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="175"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton Compressor-->

    <!--Img LDR-->
    <!--Normal-->
    <BitmapImage x:Key="Img_LDR_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_LDR_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_LDR_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_LDR_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_LDR_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_LDR_se.png"/>
    <!--Disable-->
