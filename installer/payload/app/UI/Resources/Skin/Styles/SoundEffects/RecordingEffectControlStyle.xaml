    <!--RadioButton LDR-->

    <!--Width: 75 Height: 30-->
    <!--Img RadioButton Preset-->
    <!--Normal-->
    <BitmapImage x:Key="Img_RadioButton_Preset_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_Preset_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_RadioButton_Preset_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_Preset_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_RadioButton_Preset_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_Preset_se.png"/>
    <!--Img RadioButton Preset-->
    <!--RadioButton Preset-->
    <Style x:Key="RadioButton_Preset" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton Preset-->

</ResourceDictionary>