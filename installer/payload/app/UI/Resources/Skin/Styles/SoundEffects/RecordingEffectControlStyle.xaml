<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Img AINR-->
    <!--Normal-->
    <BitmapImage x:Key="Img_AINR_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_AINR_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_AINR_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_AINR_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_AINR_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_AINR_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_AINR_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_AINR_di.png"/>
    <!--Img AINR-->
    <!--RadioButton AINR-->
    <Style x:Key="RadioButton_AINR" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="175"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton AINR-->

    <!--Img Compressor-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Compressor_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/RecordingEffect/RadioButton_Compressor_no.png"/>
