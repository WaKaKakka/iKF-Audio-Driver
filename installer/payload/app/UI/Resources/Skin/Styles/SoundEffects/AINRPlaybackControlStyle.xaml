<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Button Reset-->
    <Style x:Key="Button_Reset"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Button_Reset_Style}">
        <Setter Property="Margin" Value="20,0,0,0"/>
    </Style>
    <!--Button Reset-->

    <!--MaxWidth: 330 MaxHeight: 210-->
    <!--Img AINR-->
    <BitmapImage x:Key="Img_AINR_on" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/AINoiseReduction/Img_AINR_on.png"/>
    <BitmapImage x:Key="Img_AINR_off" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/AINoiseReduction/Img_AINR_off.png"/>
    <!--Img AINR-->
    <Style x:Key="Img_AINR" TargetType="Image">
        <Setter Property="Width" Value="330"/>
        <Setter Property="Height" Value="210"/>
    </Style>
    <!--Img AINR-->

</ResourceDictionary>