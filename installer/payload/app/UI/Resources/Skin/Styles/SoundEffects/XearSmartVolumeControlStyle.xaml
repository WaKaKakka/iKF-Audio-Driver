<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--MaxWidth: 750 MaxHeight: 90-->
    <!--Img SmartVolume-->
    <BitmapImage x:Key="Img_SmartVolume_on" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/Img_SmartVolume_on.png"/>
    <BitmapImage x:Key="Img_SmartVolume_off" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/Img_SmartVolume_off.png"/>
    <!--Img SmartVolume-->
    <Style x:Key="Img_SmartVolume" TargetType="Image">
        <Setter Property="Width" Value="268"/>
        <Setter Property="Height" Value="90"/>
    </Style>
    <!--Img SmartVolume-->

    <!--MaxWidth: 110 MaxHeight: 110-->
    <!--Img ModeMusic-->
    <!--Normal-->
    <BitmapImage x:Key="Img_ModeMusic_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeMusic_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_ModeMusic_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeMusic_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_ModeMusic_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeMusic_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_ModeMusic_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeMusic_di.png"/>
    <!--Img ModeMusic-->
    <!--RadioButton ModeMusic-->
    <Style x:Key="RadioButton_ModeMusic" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="110"/>
        <Setter Property="Height" Value="110"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton ModeMusic-->

    <!--MaxWidth: 110 MaxHeight: 110-->
    <!--Img ModeSpeech-->
    <!--Normal-->
    <BitmapImage x:Key="Img_ModeSpeech_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeSpeech_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_ModeSpeech_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeSpeech_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_ModeSpeech_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeSpeech_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_ModeSpeech_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/RadioButton_ModeSpeech_di.png"/>
    <!--Img ModeSpeech-->
    <!--RadioButton ModeSpeech-->
    <Style x:Key="RadioButton_ModeSpeech" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="110"/>
        <Setter Property="Height" Value="110"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton ModeSpeech-->

    <!--Rectangle Effect Property Value-->
    <Style x:Key="Rect_EffectPropertyValue"
           TargetType="Rectangle"
           BasedOn="{StaticResource Rect_EffectPropertyValue}">
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>
    <!--Rectangle Effect Property Value-->

    <!--Label Effect Property Value-->
    <Style x:Key="Label_EffectPropertyValue"
       TargetType="{x:Type Label}"
       BasedOn="{StaticResource Label_Main_Style}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>
    <!--Label Effect Property Value-->

    <!--MaxWidth: 270 MaxHeight: 45-->
    <!--Img SliderBackground-->
    <Style x:Key="Img_SliderBackground" TargetType="Image">
        <Setter Property="Width" Value="270"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/SmartVolume/Img_SliderBackground.png"/>
    </Style>
    <!--Img SliderBackground-->

    <!--Button Reset-->
    <Style x:Key="Button_Reset"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Button_Reset_Style}">
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>
    <!--Button Reset-->

</ResourceDictionary>