<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Rectangle Effect Property Value-->
    <Style x:Key="Rect_EffectPropertyValue"
           TargetType="Rectangle"
           BasedOn="{StaticResource Rect_EffectPropertyValue}">
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
    <!--Rectangle Effect Property Value-->

    <!--Label Effect Property Value-->
    <Style x:Key="Label_EffectPropertyValue"
           TargetType="{x:Type Label}"
           BasedOn="{StaticResource Label_Main_Style}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>
    <!--Label Effect Property Value-->

    <!--Button Reset-->
    <Style x:Key="Button_Reset"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Button_Reset_Style}">
        <Setter Property="Margin" Value="60,0,0,0"/>
    </Style>
    <!--Button Reset-->

</ResourceDictionary>