    <!--Normal-->
    <BitmapImage x:Key="Img_Clockwise_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/VirtualSpeakerShifter/RadioButton_Clockwise_no.png"/>
