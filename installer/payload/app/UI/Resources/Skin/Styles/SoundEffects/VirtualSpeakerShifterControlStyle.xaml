    <!--Disable-->
    <BitmapImage x:Key="Img_Clockwise_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/VirtualSpeakerShifter/RadioButton_Clockwise_di.png"/>
    <!--Img Clockwise-->
    <!--RadioButton Clockwise-->
    <Style x:Key="RadioButton_Clockwise" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="45"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton Clockwise-->

