<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--Img Reset-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Reset_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Reset_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Reset_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Reset_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_Reset_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Reset_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Reset_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Reset_di.png"/>
    <!--Img Reset-->
    <!--Button Reset-->
    <Style x:Key="Button_Reset" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button Reset-->

    <!--Img HeadTracking-->
    <!--Normal-->
    <BitmapImage x:Key="Img_HeadTracking_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_HeadTracking_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_HeadTracking_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_HeadTracking_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_HeadTracking_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_HeadTracking_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_HeadTracking_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_HeadTracking_di.png"/>
    <!--Img HeadTracking-->
    <!--CheckBox HeadTracking-->
    <Style x:Key="CheckBox_HeadTracking" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--CheckBox HeadTracking-->

    <!--Img Reverb-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Reverb_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_Reverb_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Reverb_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_Reverb_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_Reverb_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_Reverb_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Reverb_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/CheckBox_Reverb_di.png"/>
    <!--Img Reverb-->
    <!--CheckBox Reverb-->
    <Style x:Key="CheckBox_Reverb" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--CheckBox Reverb-->

    <!--Img Guide-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Guide_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Guide_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Guide_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Guide_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_Guide_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Button_Guide_se.png"/>
    <!--Img Guide-->
    <!--Button Guide-->
    <Style x:Key="Button_Guide" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button Guide-->

</ResourceDictionary>