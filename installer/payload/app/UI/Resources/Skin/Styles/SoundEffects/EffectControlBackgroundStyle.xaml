<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Width: 780 Height: 400-->
    <!--Img EffectControl Bg-->
    <BitmapImage x:Key="Img_EffectControl_Bg" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/Img_EffectControlBackground.png"/>
    <!--Img EffectControl Bg-->

    <!--Border Style-->
    <Style x:Key="Border_Style"
           TargetType="Border"
           BasedOn="{StaticResource Border_Gaming}">
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <!--Border Style-->

</ResourceDictionary>