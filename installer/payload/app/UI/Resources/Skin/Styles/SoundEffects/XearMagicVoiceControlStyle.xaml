<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--MaxWidth: 125 MaxHeight: 125-->
    <!--Img ModeMonster-->
    <!--Normal-->
    <BitmapImage x:Key="Img_ModeMonster_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/MagicVoice2/RadioButtons/RadioButton_Monster_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_ModeMonster_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/MagicVoice2/RadioButtons/RadioButton_Monster_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_ModeMonster_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/MagicVoice2/RadioButtons/RadioButton_Monster_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_ModeMonster_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/MagicVoice2/RadioButtons/RadioButton_Monster_di.png"/>
    <!--Img ModeMonster-->
    <!--RadioButton ModeMonster-->
    <Style x:Key="RadioButton_ModeMonster" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton ModeMonster-->

