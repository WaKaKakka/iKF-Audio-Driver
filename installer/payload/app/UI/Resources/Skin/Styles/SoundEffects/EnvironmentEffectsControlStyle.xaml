<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--MaxWidth: 80 MaxHeight: 80-->
    <!--Img ModeConcertHall-->
    <!--Normal-->
    <BitmapImage x:Key="Img_ModeConcertHall_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/EnvironmentEffects/RadioButton_ModeConcertHall_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_ModeConcertHall_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/EnvironmentEffects/RadioButton_ModeConcertHall_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_ModeConcertHall_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/EnvironmentEffects/RadioButton_ModeConcertHall_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_ModeConcertHall_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/EnvironmentEffects/RadioButton_ModeConcertHall_di.png"/>
    <!--Img ModeConcertHall-->
    <!--RadioButton ModeConcertHall-->
    <Style x:Key="RadioButton_ModeConcertHall" TargetType="{x:Type RadioButton}">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="60"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--RadioButton ModeConcertHall-->

