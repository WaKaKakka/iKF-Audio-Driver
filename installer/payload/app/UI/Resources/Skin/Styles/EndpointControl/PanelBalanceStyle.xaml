<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Width: 250 Height: 70-->
    <!--Img Balance Bg-->
    <BitmapImage x:Key="Img_Balance_Bg" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Img_Balance_Bg.png"/>
    <!--Img Balance Bg-->

    <!--Width: 74 Height: 30-->
    <!--MaxWidth: 100 MaxHeight: 30-->
    <!--Img Balance Icon-->
    <!--Center-->
    <BitmapImage x:Key="Img_Balance_Center" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Img_Balance_Center.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Balance_Disable" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Img_Balance_Disable.png"/>
    <!--Left-->
    <BitmapImage x:Key="Img_Balance_Left" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Img_Balance_Left.png"/>
    <!--Right-->
    <BitmapImage x:Key="Img_Balance_Right" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Img_Balance_Right.png"/>
    <!--Img Balance Icon-->

    <!--Width: 42 Height: 20-->
    <!--Img BalanceValue-->
    <BitmapImage x:Key="Img_BalanceValue" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Img_BalanceValue.png"/>
    <!--Img BalanceValue-->

    <!--Img Thumb Balance-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Thumb_Balance_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Thumb_Balance_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Thumb_Balance_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Thumb_Balance_mo.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Thumb_Balance_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/BalancePanel/Thumb_Balance_di.png"/>
    <!--Img Thumb Balance-->
    <!--MaxWidth: 16 MaxHeight: 16-->
    <!--Thumb Balance-->
    <Style x:Key="Thumb_Balance" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <!--Thumb Balance-->

    <!--Slider Balance-->
    <Style x:Key="Slider_Balance" TargetType="{x:Type Slider}">
        <Setter Property="Width" Value="123"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Slider Balance-->

</ResourceDictionary>