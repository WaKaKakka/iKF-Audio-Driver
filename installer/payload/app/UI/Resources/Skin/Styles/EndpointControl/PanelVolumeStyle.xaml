<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--Img Volume Bg-->
    <BitmapImage x:Key="Img_Volume_Bg" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/VolumePanel/Img_Volume_Bg.png"/>
    <!--Img Volume Bg-->

    <!--Img Volume Tick-->
    <BitmapImage x:Key="Img_Volume_Tick" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/VolumePanel/Img_Volume_Tick.png"/>
    <!--Img Volume Tick-->

    <!--CheckBox UnitChange-->
    <Style x:Key="CheckBox_UnitChange" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--CheckBox UnitChange-->

    <!--MaxHeight: 200-->
    <!--Slider Volume-->
    <Style x:Key="Slider_Volume"
           TargetType="{x:Type Slider}"
           BasedOn="{StaticResource Slider_Vertical_Style}">
        <Setter Property="Height" Value="175"/>
    </Style>
</ResourceDictionary>