<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--Width: 310 Height: 583-->
    <!--Img EndpointConsole Bg-->
    <BitmapImage x:Key="Img_EndpointConsole_Bg" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/Img_EndpointConsole_Bg.png"/>
    <!--Img EndpointConsole Bg-->

    <!--MaxWidth: 30 MaxHeight: 30-->
    <!--Img LED-->
    <!--Normal-->
    <BitmapImage x:Key="Img_LED_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/LEDPanel/Button_LED_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_LED_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/LEDPanel/Button_LED_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_LED_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/LEDPanel/Button_LED_se.png"/>
    <!--Img LED-->
    <!--Button LED-->
    <Style x:Key="Button_LED" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button LED-->

    <!--MaxWidth: 30 MaxHeight: 60-->
    <!--Img JackSetting-->
    <!--Normal-->
    <BitmapImage x:Key="Img_JackSetting_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/TitlePanel/Button_JackSetting_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_JackSetting_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/TitlePanel/Button_JackSetting_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_JackSetting_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/EndpointControl/TitlePanel/Button_JackSetting_se.png"/>
    <!--Img JackSetting-->
    <!--Button JackSetting-->
    <Style x:Key="Button_JackSetting" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button JackSetting-->

</ResourceDictionary>