    <Color x:Key="Color_Stroke">#FF909090</Color>
    <!--Color-->

    <!--Width: 30 Height: 30-->
    <!--Img Crosshair-->
    <BitmapImage x:Key="Img_Crosshair" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/LEDControl/Img_Crosshair.png"/>
    <!--Img Crosshair-->

    <!--Width: 30 Height: 10-->
    <!--Img ValueCursor-->
    <BitmapImage x:Key="Img_ValueCursor" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/LEDControl/Img_ValueCursor.png"/>
    <!--Img ValueCursor-->

    <!--Button Color 1-->
    <Style x:Key="Button_Color_1" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="20"/>
