<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Color-->
    <Color x:Key="Color_1">#FFFE0303</Color>
    <Color x:Key="Color_2">#FFFFA003</Color>
    <Color x:Key="Color_3">#FFFEF605</Color>
    <Color x:Key="Color_4">#FF03FF04</Color>
    <Color x:Key="Color_5">#FF04C2FF</Color>
    <Color x:Key="Color_6">#FF0466D9</Color>
    <Color x:Key="Color_7">#FFFF3BE8</Color>
    <Color x:Key="Color_1_Disable">#64FE0303</Color>
    <Color x:Key="Color_2_Disable">#64FFA003</Color>
    <Color x:Key="Color_3_Disable">#64FEF605</Color>
    <Color x:Key="Color_4_Disable">#6403FF04</Color>
