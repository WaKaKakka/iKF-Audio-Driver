<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Img Apply-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Apply_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/Information/Button_Apply_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Apply_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/Information/Button_Apply_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_Apply_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/Information/Button_Apply_se.png"/>
    <!--Img Apply-->
    <!--Button Apply-->
    <Style x:Key="Button_Apply" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="55"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button Apply-->

    <!--Img FWUpdate-->
    <!--Normal-->
    <BitmapImage x:Key="Img_FWUpdate_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/Information/Button_FWUpdate_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_FWUpdate_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/Information/Button_FWUpdate_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_FWUpdate_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/ControlWindow/Information/Button_FWUpdate_se.png"/>
    <!--Img FWUpdate-->
    <!--Button FWUpdate-->
    <Style x:Key="Button_FWUpdate" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="140"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button FWUpdate-->

</ResourceDictionary>