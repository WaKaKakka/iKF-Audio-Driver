<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--Color Resources-->
    <Color x:Key="Color_Background">#FF0A101C</Color>
    <Color x:Key="Color_Background_Stroke">#FF2A323F</Color>
    <Color x:Key="Color_RectButtonBackground">#FF171E2A</Color>
    <Color x:Key="Color_RectButtonBackground_Stroke">#FF3D4655</Color>

    <Color x:Key="Color_Label_Main">#D6E4FF</Color>
    <Color x:Key="Color_Label_Sub">#BED6E4FF</Color>
    <Color x:Key="Color_Disable">#FF6D6D6D</Color>

    <Color x:Key="Color_FillFull">#FF527AF5</Color>

    <Color x:Key="Color_Border_Gaming">#FF00FFFF</Color>
    <!--Color Resources-->

    <!--ToolTip Color-->
    <Color x:Key="Color_ToolTip_Text">#FFFFFFFF</Color>
    <Color x:Key="Color_ToolTip_1">#FF4A90E2</Color>
    <Color x:Key="Color_ToolTip_2">#FF8E44AD</Color>
    <!--ToolTip Color-->
    <!--ToolTip Border-->
    <Style x:Key="ToolTip_Border" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
        <Setter Property="Padding" Value="6"/>
    </Style>
    <!--ToolTip Border-->

    <!--Border Gaming Color-->
    <Color x:Key="Border_Gaming_Color_1">#FF00FFFF</Color>
    <Color x:Key="Border_Gaming_Color_2">#FF0000FF</Color>
    <Color x:Key="Border_Gaming_Color_3">#FF800080</Color>
    <!--Border Gaming Color-->
    <!--Border Gaming-->
    <Style x:Key="Border_Gaming" TargetType="Border">
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Border_Gaming_Color_1}" Offset="0.0"/>
                    <GradientStop Color="{StaticResource Border_Gaming_Color_2}" Offset="0.5"/>
                    <GradientStop Color="{StaticResource Border_Gaming_Color_3}" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <!--Border Gaming-->

    <!--Img Close-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Close_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Button_Close_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Close_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Button_Close_mo.png"/>
    <!--Img Close-->
    <!--Button Close-->
    <Style x:Key="Button_Close" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button Close-->

    <!--Img Reset-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Reset_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Button_Reset_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Reset_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Button_Reset_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_Reset_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Button_Reset_se.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Reset_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Button_Reset_di.png"/>
    <!--Img Reset-->
    <!--Button Reset-->
    <Style x:Key="Button_Reset" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Button Reset-->

    <!--Img EffectControlSwitch-->
    <!--Normal-->
    <BitmapImage x:Key="Img_EffectControlSwitch_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/CheckBox_EffectControlSwitch_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_EffectControlSwitch_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/CheckBox_EffectControlSwitch_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_EffectControlSwitch_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/CheckBox_EffectControlSwitch_se.png"/>
    <!--Img EffectControlSwitch-->
    <!--Checkbox EffectControlSwitch-->
    <Style x:Key="CheckBox_EffectControlSwitch" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Checkbox EffectControlSwitch-->

    <!--Img CheckBox-->
    <!--Normal-->
    <BitmapImage x:Key="Img_CheckBox_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/CheckBox_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_CheckBox_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/CheckBox_mo.png"/>
    <!--Selected-->
    <BitmapImage x:Key="Img_CheckBox_se" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/CheckBox_se.png"/>
    <!--Img CheckBox-->
    <!--CheckBox-->
    <Style x:Key="CheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--CheckBox-->

    <!--Rectangle Effect Property Value-->
    <ImageBrush x:Key="ImageBrush_EffectPropertyValue"
                ImageSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Img_EffectPropertyValue.png"
                Stretch="Fill"/>
    <!--Rect EffectPropertyValue-->
    <Style x:Key="Rect_EffectPropertyValue" TargetType="Rectangle">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="RadiusX" Value="5"/>
        <Setter Property="RadiusY" Value="5"/>
        <Setter Property="Fill" Value="{StaticResource ImageBrush_EffectPropertyValue}"/>
    </Style>
    <!--Rect EffectPropertyValue-->

    <!-- ScrollBar Thumb Color-->
    <Color x:Key="Color_ScrollBar_Thumb">#FF555555</Color>
    <!-- ScrollBar Thumb Color-->

    <!--Slider Style-->
    <!--Colors-->
    <Color x:Key="Color_SliderBg">#FF0A101C</Color>
    <Color x:Key="Color_SliderFull">#FF527AF5</Color>
    <Color x:Key="Color_SliderStroke">#FF5C6577</Color>
    <Color x:Key="Color_SliderDisable">#FF3B414D</Color>
    <!--Colors-->
    <!--Img Vertical Thumb-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Thumb_Vertical_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Thumb_Vertical_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Thumb_Vertical_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Thumb_Vertical_mo.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Thumb_Vertical_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Thumb_Vertical_di.png"/>
    <!--Img Vertical Thumb-->
    <!--Thumb Vertical-->
    <!--MaxWidth: 15-->
    <Style x:Key="Thumb_Vertical" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Thumb Vertical-->

    <!--Img Horizontal Thumb-->
    <!--Normal-->
    <BitmapImage x:Key="Img_Thumb_Horizontal_no" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Thumb_Horizontal_no.png"/>
    <!--MouseOver-->
    <BitmapImage x:Key="Img_Thumb_Horizontal_mo" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Thumb_Horizontal_mo.png"/>
    <!--Disable-->
    <BitmapImage x:Key="Img_Thumb_Horizontal_di" UriSource="pack://siteoforigin:,,,/Resources/Skin/Images/Common/Thumb_Horizontal_di.png"/>
    <!--Img Horizontal Thumb-->
    <!--MaxHeight: 15-->
    <!--Thumb Horizontal-->
    <Style x:Key="Thumb_Horizontal" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!--Thumb Horizontal-->
    <!--Slider Style-->

    <!--TextBox-->
    <Style x:Key="TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Width" Value="125"/>
        <Setter Property="Height" Value="25"/>
    </Style>
    <!--TextBox-->

</ResourceDictionary>