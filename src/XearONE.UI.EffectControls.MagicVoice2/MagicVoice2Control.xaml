          <RadioButton Name="rbWoman" Style="{StaticResource RadioButton_ModeWoman_Style}" Click="Woman_Click" />
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Width="758" Orientation="Horizontal">
          <RadioButton Name="rbManAi" Style="{StaticResource RadioButton_ModeManAi_Style}" Click="ManAi_Click" />
          <RadioButton Name="rbWomanAi" Style="{StaticResource RadioButton_ModeWomanAi_Style}" Click="WomanAi_Click" />
          <RadioButton Name="rbBoyAi" Style="{StaticResource RadioButton_ModeBoyAi_Style}" Click="BoyAi_Click" />
          <RadioButton Name="rbGirlAi" Style="{StaticResource RadioButton_ModeGirlAi_Style}" Click="GirlAi_Click" />
        </StackPanel>
      </Grid>
      <Grid Name="grdPeakMeter" Row="1" Column="1">
        <Border Background="{StaticResource SolidColorBrush_RectButtonBackground}" CornerRadius="10" Margin="30,0,50,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="4" />
              <RowDefinition Height="20" />
              <RowDefinition Height="*" />
              <RowDefinition Height="4" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <Label Content="{DynamicResource MagicVoiceII_Label_VoiceMonitor}" Grid.Row="1" Grid.ColumnSpan="6" Margin="0,-4,0,-2" HorizontalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
            <Slider Name="Slider_PeakMeter_L" Grid.Row="2" Grid.Column="1" Style="{StaticResource Slider_PeakMeter_Style}" />
            <Slider Name="Slider_PeakMeter_R" Grid.Row="2" Grid.Column="2" Style="{StaticResource Slider_PeakMeter_Style}" />
            <Image Grid.Row="2" Grid.Column="4" Width="30" Height="140" VerticalAlignment="Top" Margin="0,5,0,0" Source="{StaticResource Img_Volume_Tick}" />
            <Slider Name="slMasterVolume" Grid.Row="2" Grid.Column="4" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0" Height="140" Value="80" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Orientation="Vertical" Style="{StaticResource Slider_Vertical_Style}" ToolTip="{DynamicResource ToolTip_Slider_MasterVolume}" ValueChanged="Slider_MasterVolume_ValueChanged" />
            <CheckBox Name="chkListen" Grid.Row="2" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,2" Style="{StaticResource CheckBox_Listen_Style}" Click="Btn_Listen_Click" />
          </Grid>
        </Border>
      </Grid>
      <Grid Name="grdAiMagicVoice" Row="2">
        <Border Background="{StaticResource SolidColorBrush_RectButtonBackground}" CornerRadius="10" Margin="20,20,40,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="20" />
              <RowDefinition Height="30" />
              <RowDefinition Height="26" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="350" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="{DynamicResource MagicVoiceII_Label_Low}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,-2,0,-4" Style="{StaticResource Label_Main_Style}" />
            <Label Content="{DynamicResource MagicVoiceII_Label_High}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,-2,10,-4" Style="{StaticResource Label_Main_Style}" />
            <Slider Name="slPitch" Grid.Row="1" Grid.Column="0" Margin="0,-4,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Minimum="-16" Maximum="16" TickFrequency="0.1" Value="0" Style="{StaticResource Slider_Balance_Style}" ValueChanged="Pitch_ValueChanged" />
            <Label Content="{DynamicResource MagicVoiceII_Label_PitchAdjustment}" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0" Style="{StaticResource Label_Main_Style}" />
            <Border Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Margin="0,-10,60,0" CornerRadius="5" Background="{StaticResource SolidColorBrush_Background}" Width="35" Height="25">
              <TextBlock Name="tbPitchShiftValue" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="14" Text="{Binding ElementName=slPitch, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{x:Static SystemColors.GrayTextBrush}" />
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Border>
            <Button Name="btnPitchEstimation" Grid.RowSpan="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Button_AutoPitchEstimation_Style}" Click="PitchEstimation_Click" />
          </Grid>
        </Border>
      </Grid>
      <Grid Name="grdProfile" Row="3" Column="1">
        <Border Background="{StaticResource SolidColorBrush_RectButtonBackground}" CornerRadius="10" Margin="30,20,50,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="40" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <ComboBox Name="comboProfile" Style="{StaticResource ComboBox_Style}" VerticalAlignment="Center" HorizontalAlignment="Center" DropDownClosed="Profile_DropDownClosed">
              <ComboBoxItem Content="Profile 1" />
              <ComboBoxItem Content="Profile 2" />
              <ComboBoxItem Content="Profile 3" />
            </ComboBox>
            <Grid Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="20" />
              </Grid.ColumnDefinitions>
              <Button Name="btnResetProfile" Grid.Column="1" Width="30" Height="30" HorizontalAlignment="Center" Style="{StaticResource Button_ProfileReset_Style}" Click="ResetProfile_Click" />
              <Button Name="btnSaveProfile" Grid.Column="2" Width="30" Height="30" HorizontalAlignment="Center" Style="{StaticResource Button_ProfileSave_Style}" IsEnabled="False" Click="SaveProfile_Click" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
      <MagicVoice2:WarningDialog x:Name="ucWarningDialog" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
      <MagicVoice2:PowerSettingsWindow x:Name="ucPowerSettings" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
      <Grid Name="LoadingOverlay" Row="1" RowSpan="2" Column="0" ColumnSpan="2" Background="#80000000" Visibility="Collapsed">
        <TextBlock Text="{DynamicResource MagicVoiceII_Text_Processing}" Foreground="#FFFFFFFF" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>