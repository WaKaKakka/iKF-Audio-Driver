<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="XearONE.UI.EffectControls.MagicVoice2.PitchEstimation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Personalized Voice Setup" Height="460" Width="600" WindowStyle="None" ResizeMode="NoResize" xmlns:magicvoice2="clr-namespace:XearONE.UI.EffectControls.MagicVoice2;assembly=XearONE">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Background" Value="{StaticResource SolidColorBrush_FillFull}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border CornerRadius="4" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True" />
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Background" Value="{StaticResource SolidColorBrush_RectButtonBackground}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ProgressBar}" TargetType="{x:Type ProgressBar}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Border BorderBrush="#D9DCE1" BorderThickness="0" Background="#abe1e3" CornerRadius="2" Padding="0">
                <Grid Name="PART_Track">
                  <Rectangle Name="PART_Indicator" HorizontalAlignment="Left" Fill="#FF2BA9FF" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{StaticResource SolidColorBrush_Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="90" />
      <RowDefinition Height="130" />
      <RowDefinition Height="50" />
      <RowDefinition Height="50" />
      <RowDefinition Height="40" />
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" MouseDown="Grid_Title_MouseDown">
      <Rectangle>
        <Shape.Fill>
          <SolidColorBrush Color="{StaticResource Color_RectButtonBackground}" />
        </Shape.Fill>
        <Shape.Stroke>
          <SolidColorBrush Color="{StaticResource Color_RectButtonBackground_Stroke}" />
        </Shape.Stroke>
      </Rectangle>
      <Label Content="{DynamicResource MagicVoiceII_PersonalizedVoiceSetup_Title}" Style="{StaticResource Label_WindowTitle_Style}" />
      <Button Name="Btn_Close" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Button_Close_Style}" Click="Btn_Close_Click" />
    </Grid>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="50" />
        <ColumnDefinition Width="500" />
        <ColumnDefinition Width="50" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" FontSize="18" Text="{DynamicResource MagicVoiceII_PersonalizedVoiceSetup_Instruction}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush_Label_Main}" />
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource SolidColorBrush_RectButtonBackground}" Width="500" Height="117" CornerRadius="10">
      <TextBlock Grid.Row="1" FontSize="16" Text="{DynamicResource MagicVoiceII_PersonalizedVoiceSetup_Script}" TextWrapping="Wrap" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush_Label_Main}" LineHeight="26" />
    </Border>
    <TextBlock Name="txtProgress" Text="0%" Grid.Row="3" Margin="520,0,0,0" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SolidColorBrush_Label_Main}" />
    <ProgressBar Name="progressRecordingTime" Grid.Row="3" Value="0" Height="12" Minimum="0" Maximum="100" Margin="100,2,100,2" />
    <Grid Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Width="50" Background="#00FFFFFF" BorderThickness="0">
        <Image Source="\Resources\Microphone_Standby.png" />
      </Button>
      <Border Grid.Column="1" BorderBrush="#38404D" BorderThickness="1" Margin="2,2">
        <Grid Background="{StaticResource SolidColorBrush_Background}">
          <Canvas Name="waveformCanvas" Margin="10,10" />
        </Grid>
      </Border>
    </Grid>
    <Grid Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80" />
        <ColumnDefinition Width="440" />
        <ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <Slider Name="slMasterVolume" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Minimum="0" Maximum="100" Value="50" Style="{StaticResource Slider_Horizontal_Style}" ValueChanged="Volume_ValueChanged" />
      <Image Grid.Column="0" Source="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/MagicVoice2/Icon_SpeakerMin.png" Width="22" Height="20" Visibility="Visible" />
      <Image Grid.Column="2" Source="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/MagicVoice2/Icon_SpeakerMax.png" Width="32" Height="20" Visibility="Visible" />
    </Grid>
    <Grid Row="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Name="btnNext" Content="{DynamicResource MagicVoiceII_PersonalizedVoiceSetup_Start}" Grid.Column="1" Width="150" Height="35" Click="Next_Click" />
      <TextBlock Name="txtPitchResult" Grid.Column="2" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource SolidColorBrush_Label_Main}" />
    </Grid>
  </Grid>
</Window>