<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.GlobalProfile.ProfileAddControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.GlobalProfile" Width="300" Height="100" Loaded="ProfileAddControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid Margin="10">
    <Border Name="Background" Background="{StaticResource SolidColorBrush_RectButtonBackground}" CornerRadius="5" BorderBrush="{StaticResource SolidColorBrush_Background_Stroke}" BorderThickness="1" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <TextBox Name="TextBox_ProfileName" Grid.Column="0" Width="180" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0" TextAlignment="Left" VerticalContentAlignment="Center" FontSize="18" Style="{StaticResource TextBox_Style}" />
      <Label Name="Label_Error" Grid.Column="0" Width="180" Height="25" HorizontalAlignment="Center" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Content="" Foreground="#FFFF0000" FontSize="13" />
      <Button Name="Button_AddProfile" Grid.Column="1" Width="40" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Add" Click="Button_AddProfile_Click" />
    </Grid>
  </Grid>
</UserControl>