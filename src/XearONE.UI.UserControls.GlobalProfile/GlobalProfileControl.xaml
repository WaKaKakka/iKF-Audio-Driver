<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.GlobalProfile.GlobalProfileControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.GlobalProfile" Width="150" Height="60" Loaded="GlobalProfileControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="Button_Profile_Template" TargetType="{x:Type Button}">
        <Grid>
          <Border Name="Background" Background="#00000000" CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource SolidColorBrush_Background_Stroke}" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Background" Property="Border.BorderBrush" Value="{StaticResource SolidColorBrush_Background_Stroke_mo}" />
            <Setter TargetName="Background" Property="Border.BorderThickness" Value="3" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Profile_Style" TargetType="{x:Type Button}">
        <Setter Property="Template" Value="{StaticResource Button_Profile_Template}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Border Name="Background" Background="{StaticResource SolidColorBrush_RectButtonBackground}" CornerRadius="5" />
    <Label Content="Profile" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,3,5,0" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" />
    <Label Name="Label_ProfileName" Height="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5,0,5,3" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
    <Button Name="Button_Profile" Style="{StaticResource Button_Profile_Style}" Click="Button_Profile_Click" />
  </Grid>
</UserControl>