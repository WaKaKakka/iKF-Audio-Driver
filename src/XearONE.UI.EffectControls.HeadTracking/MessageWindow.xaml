<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.HeadTracking.MessageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="280" Height="310" Background="#00000000" xmlns:headtracking="clr-namespace:XearONE.UI.EffectControls.HeadTracking;assembly=XearONE">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="3*" />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="3">
      <Shape.Fill>
        <SolidColorBrush Color="{StaticResource Color_Background}" />
      </Shape.Fill>
      <Shape.Stroke>
        <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
      </Shape.Stroke>
    </Rectangle>
    <Grid Row="0">
      <Rectangle>
        <Shape.Fill>
          <SolidColorBrush Color="{StaticResource Color_RectButtonBackground}" />
        </Shape.Fill>
        <Shape.Stroke>
          <SolidColorBrush Color="{StaticResource Color_RectButtonBackground_Stroke}" />
        </Shape.Stroke>
      </Rectangle>
      <Label Content="{DynamicResource Label_Title_WarningWindow}" HorizontalAlignment="Center" Margin="0,0,0,0" Style="{StaticResource Label_WindowTitle_Style}" />
    </Grid>
    <Grid Row="1">
      <Label Content="{DynamicResource Label_WarningMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="20" />
    </Grid>
  </Grid>
</UserControl>