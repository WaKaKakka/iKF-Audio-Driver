<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.HeadTracking.HeadTrackingGuideControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls.HeadTracking" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="Rect_Style" TargetType="{x:Type Rectangle}">
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="Stroke" Value="#FFFF0000" />
        <Style.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:1" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Width="780" Height="400" Source="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/Img_GuideBG.png" Visibility="Hidden" />
    <Image Name="Img_Wave" Width="62" Height="105" HorizontalAlignment="Left" Source="pack://siteoforigin:,,,/Resources/Skin/Images/SoundEffects/HeadTracking/GuideWindow/Img_Wave_L.png" Margin="0,50,0,0" />
    <Rectangle Name="Rect_Switch" RadiusX="5" RadiusY="5" Margin="490,115,40,160" Style="{StaticResource Rect_Style}" />
    <Rectangle Name="Rect_Frame" RadiusX="5" RadiusY="5" Margin="65,95,365,35" Style="{StaticResource Rect_Style}" />
    <Rectangle Name="Rect_ReCenter" RadiusX="5" RadiusY="5" Margin="565,260,115,50" Style="{StaticResource Rect_Style}" />
  </Grid>
</UserControl>