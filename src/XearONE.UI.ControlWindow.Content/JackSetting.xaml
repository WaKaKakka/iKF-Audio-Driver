<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.ControlWindow.Content.JackSetting" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.ControlWindow.Content" Width="600" Height="560" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\ControlWindow\JackSettingStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="RadioButton_DefaultDevice_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_EffectControlSwitch_no}" />
          <Image Name="stroke" Visibility="Hidden" Source="{StaticResource Img_EffectControlSwitch_mo}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="stroke" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectControlSwitch_se}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectControlSwitch_no}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_DefaultDevice_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_DefaultDevice}">
        <Setter Property="Template" Value="{StaticResource RadioButton_DefaultDevice_Template}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="30,30,30,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="1*" />
      <RowDefinition Height="10" />
      <RowDefinition Height="0.8*" />
      <RowDefinition Height="10" />
      <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="{DynamicResource Label_Title_DefaultDevice}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="18" />
      <Grid Row="1" Margin="30,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <RadioButton Name="RadioButton_DefaultDevice" Grid.Row="0" GroupName="DefaultDevice" HorizontalAlignment="Left" VerticalAlignment="Center" Tag="1" Style="{StaticResource RadioButton_DefaultDevice_Style}" ToolTip="{DynamicResource ToolTip_RadioButton_DefaultDevice}" Click="RadioButton_DefaultDevice_Click" />
        <Label Grid.Row="0" Content="{DynamicResource Label_DefaultDevice}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="60,0,0,0" Style="{StaticResource Label_Main_Style}" FontSize="14" />
        <RadioButton Name="RadioButton_DefaultCommunicationDevice" Grid.Row="1" GroupName="DefaultCommunicationDevice" HorizontalAlignment="Left" VerticalAlignment="Center" Tag="2" Style="{StaticResource RadioButton_DefaultDevice_Style}" ToolTip="{DynamicResource ToolTip_RadioButton_DefaultCommunicationDevice}" Click="RadioButton_DefaultDevice_Click" />
        <Label Grid.Row="1" Content="{DynamicResource Label_DefaultCommunicationDevice}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="60,0,0,0" Style="{StaticResource Label_Main_Style}" FontSize="14" />
      </Grid>
    </Grid>
    <Grid Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="{DynamicResource Label_Title_DeviceFormat}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="18" />
      <Grid Row="1" Margin="30,0,0,0">
        <Label Grid.Column="0" Content="{DynamicResource Label_Format}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
        <ComboBox Name="Combo_Format" Grid.Column="1" Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ComboBox_Style}" Margin="70,0,0,0" SelectionChanged="Combo_Format_SelectionChanged" />
      </Grid>
    </Grid>
    <Grid Row="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="{DynamicResource Label_Title_DeviceInformation}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="18" />
      <Grid Row="1" Margin="30,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{DynamicResource Label_DeviceName}" Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{DynamicResource Label_FirmwareVersion}" Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{DynamicResource Label_DriverVersion}" Style="{StaticResource Label_Main_Style}" />
        <Label Name="Label_DeviceName" Grid.Row="0" Grid.Column="1" Content="DeviceName" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
        <Label Name="Label_FirmwareVer" Grid.Row="1" Grid.Column="1" Content="FirmwareVer" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
        <Label Name="Label_DriverVer" Grid.Row="2" Grid.Column="1" Content="DriverVer" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>