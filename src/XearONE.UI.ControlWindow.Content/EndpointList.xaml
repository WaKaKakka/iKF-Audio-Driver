<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.ControlWindow.Content.EndpointList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.ControlWindow.Content" xmlns:sva="clr-namespace:XearONE.UI.ControlGraphicEffect" Width="600" Height="400" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\ControlWindow\EndpointListStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="30,30,30,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="50" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Margin="30,0,30,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Style="{StaticResource Playback}" />
        <Label Grid.Column="1" Content="{DynamicResource Label_Title_PlaybackDevice}" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
      </Grid>
      <Grid Column="1" Margin="30,0,30,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Style="{StaticResource Capture}" />
        <Label Grid.Column="1" Content="{DynamicResource Label_Title_CaptureDevice}" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
      </Grid>
    </Grid>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <sva:ScrollViewerAnimation Grid.Column="0" Padding="0,5,0,5" Margin="1,1,1,1">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar_V_Style}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <StackPanel Name="StackPanel_PlaybackDevice" />
      </sva:ScrollViewerAnimation>
      <sva:ScrollViewerAnimation Grid.Column="1" Padding="0,5,0,5" Margin="1,1,1,1">
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar_V_Style}" />
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <StackPanel Name="StackPanel_RecordingDevice" />
      </sva:ScrollViewerAnimation>
    </Grid>
  </Grid>
</UserControl>