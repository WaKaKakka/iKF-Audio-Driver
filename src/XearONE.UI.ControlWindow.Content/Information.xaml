<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.ControlWindow.Content.Information" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.ControlWindow.Content" Width="600" Height="400" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\ControlWindow\InformationStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="Button_Apply_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_Apply_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Apply_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Apply_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Apply_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_Apply}">
        <Setter Property="Template" Value="{StaticResource Button_Apply_Template}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Disable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="Button_FWUpdate_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_FWUpdate_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_FWUpdate_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_FWUpdate_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_FWUpdate_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_FWUpdate}">
        <Setter Property="Template" Value="{StaticResource Button_FWUpdate_Template}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Disable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="Button_Website_Template" TargetType="{x:Type Button}">
        <Grid>
          <Rectangle Name="Rect" StrokeThickness="0">
            <Shape.Fill>
              <SolidColorBrush Color="#00000000" />
            </Shape.Fill>
          </Rectangle>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Rect" Property="Shape.Fill" Value="#80000000" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Website_Style" TargetType="{x:Type Button}">
        <Setter Property="Template" Value="{StaticResource Button_Website_Template}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Content" Value="{DynamicResource Label_Button_Website}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_Website}" />
        <Setter Property="Foreground" Value="#0066CC" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="30,30,30,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="100" />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Image Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://siteoforigin:,,,/Resources/Skin/Images/MainWindow/Img_BannerLogo.png" />
    <Label Grid.Row="1" Content="Copyright © C-Media Electronics, Inc." HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
    <Button Name="Button_Website" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Button_Website_Style}" Click="Button_Website_Click" />
    <Grid Row="3" Margin="135,0,135,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Content="APP Version: " HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
      <Label Name="Label_APPVersionNumber" Grid.Column="1" Content="APPVersion" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" ToolTip="{DynamicResource Tooltip_APPVersion}" />
    </Grid>
    <Grid Row="4" Margin="135,0,135,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Content="SDK DLL Version: " HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
      <Label Name="Label_SDKVersionNumber" Grid.Column="1" Content="SDKVersion" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" ToolTip="{DynamicResource Tooltip_SDKVersion}" />
    </Grid>
    <Grid Row="5" Margin="175,0,175,0">
      <ComboBox Name="ComboBox_Lang" Width="80" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ComboBox_Style}" SelectionChanged="ComboBox_Lang_SelectionChanged" />
      <Button Name="Button_LangApply" Width="55" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{DynamicResource Label_Button_Apply}" Style="{StaticResource Button_Apply_Style}" ToolTip="{DynamicResource Tooltip_Button_Apply}" IsEnabled="False" Click="Button_LangApply_Click" />
    </Grid>
    <Grid Row="6">
      <Button Name="Button_FWUpdate" Width="140" Height="25" VerticalAlignment="Center" Content="{DynamicResource Label_Button_FWUpdate}" Style="{StaticResource Button_FWUpdate_Style}" ToolTip="{DynamicResource Tooltip_FWUpdate}" Click="Button_FWUpdate_Click" />
    </Grid>
  </Grid>
</UserControl>