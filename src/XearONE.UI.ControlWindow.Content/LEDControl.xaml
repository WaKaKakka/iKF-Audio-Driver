      <ControlTemplate x:Key="Button_Color_1_Template" TargetType="{x:Type Button}">
        <Grid>
          <Rectangle Name="Rect" RadiusX="5" RadiusY="5" StrokeThickness="1">
            <Shape.Fill>
              <SolidColorBrush Color="{StaticResource Color_1}" />
            </Shape.Fill>
            <Shape.Stroke>
              <SolidColorBrush Color="{StaticResource Color_Stroke}" />
            </Shape.Stroke>
          </Rectangle>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Rect" Property="Shape.StrokeThickness" Value="2" />
            <Setter TargetName="Rect" Property="Shape.Stroke" Value="{StaticResource SolidColorBrush_Background_Stroke_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Rect" Property="Shape.StrokeThickness" Value="3" />
            <Setter TargetName="Rect" Property="Shape.Stroke" Value="{StaticResource SolidColorBrush_Background_Stroke_mo}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Rect" Property="Shape.Fill" Value="{StaticResource SolidColorBrush_1_Disable}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Color_1_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_Color_1}">
