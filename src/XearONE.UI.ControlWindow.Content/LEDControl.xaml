  <Grid Margin="30,30,30,30">
    <Grid.RowDefinitions>
      <RowDefinition Height="100" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="50,0,50,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Content="LED Control" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" />
      <CheckBox Name="Btn_Enable" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
    </Grid>
    <Grid Row="1" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
      <Grid.RowDefinitions>
        <RowDefinition Height="5*" />
        <RowDefinition Height="1*" />
        <RowDefinition Height="2.5*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="50,0,50,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Canvas Name="ColorCanvas" Width="200" Height="200" MouseDown="ColorCanvas_MouseAction" MouseMove="ColorCanvas_MouseAction" MouseUp="ColorCanvas_MouseAction">
            <Panel.Background>
              <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" />
                <GradientStop Color="White" Offset="1" />
              </LinearGradientBrush>
            </Panel.Background>
            <Image Name="Img_ColorBrush" />
            <Image Name="Img_Crosshair" Width="30" Height="30" Canvas.Left="-15" Canvas.Top="-15" Source="{StaticResource Img_Crosshair}" />
          </Canvas>
        </Grid>
        <Grid Column="1">
          <Canvas Name="ValueCanvas" Width="10" Height="200" MouseDown="ValueCanvas_MouseAction" MouseMove="ValueCanvas_MouseAction" MouseUp="ValueCanvas_MouseAction">
            <Image Name="Img_ValueBrush" />
            <Image Name="Img_ValueCursor" Width="30" Height="10" Canvas.Left="-10" Canvas.Top="-5" Source="{StaticResource Img_ValueCursor}" />
          </Canvas>
        </Grid>
        <Grid Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="150" />
          </Grid.RowDefinitions>
          <Rectangle Name="SelectedColorRect" Grid.Row="0" Width="50" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="#FF000000" />
          <Grid Name="Grid_ColorSlider" Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="50" />
              <RowDefinition Height="50" />
              <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <Label Content="R" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
              <Slider Name="Slider_Color_R" Grid.Column="1" Style="{StaticResource Slider_Color_Style}" PreviewMouseMove="Slider_Color_PreviewMouseAction" />
              <Label Name="Label_Color_R" Grid.Column="2" Content="255" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            </Grid>
            <Grid Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <Label Content="G" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
              <Slider Name="Slider_Color_G" Grid.Column="1" Style="{StaticResource Slider_Color_Style}" PreviewMouseMove="Slider_Color_PreviewMouseAction" />
              <Label Name="Label_Color_G" Grid.Column="2" Content="255" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            </Grid>
            <Grid Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <Label Content="B" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
              <Slider Name="Slider_Color_B" Grid.Column="1" Style="{StaticResource Slider_Color_Style}" PreviewMouseMove="Slider_Color_PreviewMouseAction" />
              <Label Name="Label_Color_B" Grid.Column="2" Content="255" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
      <Grid Name="Grid_ColorButton" Row="1" Margin="100,0,100,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Button Name="Button_DefColor0" Grid.Column="0" Style="{StaticResource Button_Color_1_Style}" Tag="0" Click="Button_DefColor_Click" />
        <Button Name="Button_DefColor1" Grid.Column="1" Style="{StaticResource Button_Color_2_Style}" Tag="1" Click="Button_DefColor_Click" />
        <Button Name="Button_DefColor2" Grid.Column="2" Style="{StaticResource Button_Color_3_Style}" Tag="2" Click="Button_DefColor_Click" />
        <Button Name="Button_DefColor3" Grid.Column="3" Style="{StaticResource Button_Color_4_Style}" Tag="3" Click="Button_DefColor_Click" />
        <Button Name="Button_DefColor4" Grid.Column="4" Style="{StaticResource Button_Color_5_Style}" Tag="4" Click="Button_DefColor_Click" />
        <Button Name="Button_DefColor5" Grid.Column="5" Style="{StaticResource Button_Color_6_Style}" Tag="5" Click="Button_DefColor_Click" />
        <Button Name="Button_DefColor6" Grid.Column="6" Style="{StaticResource Button_Color_7_Style}" Tag="6" Click="Button_DefColor_Click" />
      </Grid>
      <Grid Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Mode" FontSize="16" Style="{StaticResource Label_Sub_Style}" />
          <ComboBox Name="ComboBox_LEDMode" Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource ComboBox_Style}" SelectionChanged="ComboBox_LEDMode_SelectionChanged">
            <ComboBoxItem Name="Mode_Static" Content="{DynamicResource Combobox_Mode_0}" />
            <ComboBoxItem Name="Mode_Blink" Content="{DynamicResource Combobox_Mode_1}" />
            <ComboBoxItem Name="Mode_Breathe" Content="{DynamicResource Combobox_Mode_2}" />
            <ComboBoxItem Name="Mode_HeartBeat" Content="{DynamicResource Combobox_Mode_3}" />
          </ComboBox>
        </Grid>
        <Grid Name="Grid_Speed" Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Speed" FontSize="16" Style="{StaticResource Label_Sub_Style}" />
          <Slider Name="Slider_Speed" Grid.Row="0" Grid.Column="1" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Minimum="10" Maximum="100" LargeChange="10" SmallChange="1" Style="{StaticResource Slider_Horizontal_Style}" AutoToolTipPlacement="TopLeft" PreviewMouseMove="Slider_Speed_PreviewMouseAction" />
          <Label Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Content="FAST" FontSize="16" Style="{StaticResource Label_Sub_Style}" />
          <Label Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Content="SLOW" FontSize="16" Style="{StaticResource Label_Sub_Style}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>