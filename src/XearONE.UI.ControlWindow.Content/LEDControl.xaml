      </Style>
      <Style x:Key="Slider_Color_Style" TargetType="{x:Type Slider}" BasedOn="{StaticResource Slider_Color}">
        <Setter Property="MinHeight" Value="15" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Slider.IsSnapToTickEnabled" Value="True" />
        <Setter Property="RangeBase.Maximum" Value="255" />
        <Setter Property="RangeBase.Minimum" Value="0" />
        <Setter Property="Template" Value="{StaticResource Slider_Horizontal_Template}" />
