<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.MicEQControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="MicEQControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\MicEQControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Slider_Gain_Style" TargetType="{x:Type Slider}" BasedOn="{StaticResource Slider_Gain}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Slider.Orientation" Value="Vertical" />
        <Setter Property="RangeBase.Minimum" Value="-20" />
        <Setter Property="RangeBase.Maximum" Value="20" />
        <Setter Property="RangeBase.SmallChange" Value="1" />
        <Setter Property="RangeBase.LargeChange" Value="2" />
        <Setter Property="Slider.IsSnapToTickEnabled" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="MinWidth" Value="15" />
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="FrameworkElement.ToolTip" Value="Tooltip_Slider_Gain" />
        <Setter Property="Slider.AutoToolTipPlacement" Value="TopLeft" />
        <Setter Property="Template" Value="{StaticResource Slider_Vertical_Template}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_MicEQ}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3.5*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Label Content="{DynamicResource Label_Reset}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Button Name="Button_Reset" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Button_Reset}" ToolTip="{DynamicResource ToolTip_Button_Reset}" Click="Button_Reset_Click" />
        </Grid>
        <Grid Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid Row="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="+20 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Content="+10 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="2" Content="+0 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="3" Content="-10 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="4" Content="-20 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          </Grid>
          <Slider Name="MicEQ_Slider1" Grid.Column="1" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider2" Grid.Column="2" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider3" Grid.Column="3" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider4" Grid.Column="4" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider5" Grid.Column="5" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider6" Grid.Column="6" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider7" Grid.Column="7" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider8" Grid.Column="8" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider9" Grid.Column="9" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Slider Name="MicEQ_Slider10" Grid.Column="10" Style="{StaticResource Slider_Gain_Style}" ValueChanged="Slider_EQBand_ValueChanged" />
          <Label Grid.Row="1" Grid.Column="1" Content="31 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="2" Content="63 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="3" Content="125 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="4" Content="250 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="5" Content="500 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="6" Content="1 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="7" Content="2 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="8" Content="4 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="9" Content="8 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Grid.Column="10" Content="16 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>