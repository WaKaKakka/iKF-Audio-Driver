<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.VigilanceModeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="VigilanceModeControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\AINRPlaybackControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_VigilanceMode}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <RadioButton Name="RadioButton_VigilanceMode_0" Grid.Column="0" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" GroupName="Mode" Content="0" Tag="0" Checked="RadioButton_VigilanceMode_Checked" />
        <RadioButton Name="RadioButton_VigilanceMode_1" Grid.Column="1" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" GroupName="Mode" Content="1" Tag="1" Checked="RadioButton_VigilanceMode_Checked" />
        <RadioButton Name="RadioButton_VigilanceMode_2" Grid.Column="2" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" GroupName="Mode" Content="2" Tag="2" Checked="RadioButton_VigilanceMode_Checked" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>