  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_EnvironmentEffects}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" Margin="150,0,0,0" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Grid Row="0" Margin="30,0,0,0">
            <Label Content="{DynamicResource Label_Environment}" Style="{StaticResource Label_Sub_Style}" />
          </Grid>
          <Grid Row="1" Margin="60,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid>
              <ComboBox Name="ComboBox_EnvMode" Width="200" Height="25" HorizontalAlignment="Left" Style="{StaticResource ComboBox_Style}" DropDownClosed="ComboBox_EnvMode_DropDownClosed">
                <ComboBoxItem Name="None" Content="{DynamicResource Label_EMMode_None}" />
                <ComboBoxItem Name="Generic" Content="{DynamicResource Label_EMMode_Generic}" />
                <ComboBoxItem Name="PaddedCell" Content="{DynamicResource Label_EMMode_PaddedCell}" />
                <ComboBoxItem Name="Room" Content="{DynamicResource Label_EMMode_Room}" />
                <ComboBoxItem Name="Bathroom" Content="{DynamicResource Label_EMMode_Bathroom}" />
                <ComboBoxItem Name="LivingRoom" Content="{DynamicResource Label_EMMode_LivingRoom}" />
                <ComboBoxItem Name="StoneRoom" Content="{DynamicResource Label_EMMode_StoneRoom}" />
                <ComboBoxItem Name="Auditorium" Content="{DynamicResource Label_EMMode_Auditorium}" />
                <ComboBoxItem Name="ConcertHall" Content="{DynamicResource Label_EMMode_ConcertHall}" />
                <ComboBoxItem Name="Cave" Content="{DynamicResource Label_EMMode_Cave}" />
                <ComboBoxItem Name="Arena" Content="{DynamicResource Label_EMMode_Arena}" />
                <ComboBoxItem Name="Hangar" Content="{DynamicResource Label_EMMode_Hangar}" />
                <ComboBoxItem Name="CarpetedHallway" Content="{DynamicResource Label_EMMode_CarpetedHallway}" />
                <ComboBoxItem Name="Hallwayv" Content="{DynamicResource Label_EMMode_Hallway}" />
                <ComboBoxItem Name="StoneCorridor" Content="{DynamicResource Label_EMMode_StoneCorridor}" />
                <ComboBoxItem Name="Alley" Content="{DynamicResource Label_EMMode_Alley}" />
                <ComboBoxItem Name="Forest" Content="{DynamicResource Label_EMMode_Forest}" />
                <ComboBoxItem Name="City" Content="{DynamicResource Label_EMMode_City}" />
                <ComboBoxItem Name="Mountains" Content="{DynamicResource Label_EMMode_Mountains}" />
                <ComboBoxItem Name="Quarry" Content="{DynamicResource Label_EMMode_Quarry}" />
                <ComboBoxItem Name="Plain" Content="{DynamicResource Label_EMMode_Plain}" />
                <ComboBoxItem Name="ParkingLot" Content="{DynamicResource Label_EMMode_ParkingLot}" />
                <ComboBoxItem Name="SewerPipe" Content="{DynamicResource Label_EMMode_SewerPipe}" />
                <ComboBoxItem Name="UnderWater" Content="{DynamicResource Label_EMMode_UnderWater}" />
                <ComboBoxItem Name="Drugged" Content="{DynamicResource Label_EMMode_Drugged}" />
                <ComboBoxItem Name="Dizzy" Content="{DynamicResource Label_EMMode_Dizzy}" />
                <ComboBoxItem Name="Psychotic" Content="{DynamicResource Label_EMMode_Psychotic}" />
                <ComboBoxItem Name="Karaoke" Content="{DynamicResource Label_EMMode_Karaoke}" />
              </ComboBox>
            </Grid>
            <Grid Row="1">
