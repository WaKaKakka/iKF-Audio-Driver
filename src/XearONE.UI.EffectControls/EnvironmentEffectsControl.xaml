      <ControlTemplate x:Key="RadioButton_ModeConcertHall_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeConcertHall_no}" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeConcertHall_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeConcertHall_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeConcertHall_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeConcertHall_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_ModeConcertHall}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeConcertHall_Template}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Label_EMMode_ConcertHall}" />
