              </Grid.ColumnDefinitions>
              <RadioButton Name="RadioButton_ModeConcertHall" Grid.Column="0" Tag="8" Style="{StaticResource RadioButton_ModeConcertHall_Style}" Click="Btn_EMMode_Click" />
              <RadioButton Name="RadioButton_ModeUnderwater" Grid.Column="1" Tag="23" Style="{StaticResource RadioButton_ModeUnderwater_Style}" Click="Btn_EMMode_Click" />
              <RadioButton Name="RadioButton_ModeBathroom" Grid.Column="2" Tag="4" Style="{StaticResource RadioButton_ModeBathroom_Style}" Click="Btn_EMMode_Click" />
              <RadioButton Name="RadioButton_ModePsychotic" Grid.Column="3" Tag="26" Style="{StaticResource RadioButton_ModePsychotic_Style}" Click="Btn_EMMode_Click" />
            </Grid>
          </Grid>
