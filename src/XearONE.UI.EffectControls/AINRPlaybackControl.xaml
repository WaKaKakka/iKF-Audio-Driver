<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.AINRPlaybackControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="AINRPlaybackControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\AINRPlaybackControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Img_AINR_Style" TargetType="{x:Type Image}" BasedOn="{StaticResource Img_AINR}">
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="True">
            <Setter Property="Source" Value="{StaticResource Img_AINR_on}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Source" Value="{StaticResource Img_AINR_off}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_AINRPlayback}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="100" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="1.5*" />
              <RowDefinition Height="1*" />
              <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{DynamicResource Label_Level}" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Content="{DynamicResource Label_Low}" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource Label_Main_Style}" FontSize="12" />
            <Label Grid.Row="1" Content="{DynamicResource Label_Medium}" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="12" />
            <Label Grid.Row="1" Content="{DynamicResource Label_High}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Label_Main_Style}" FontSize="12" />
            <Slider Name="Slider_Level" Grid.Row="2" VerticalAlignment="Center" Minimum="1" Maximum="3" SmallChange="1" Style="{StaticResource Slider_Horizontal_Style}" ToolTip="{DynamicResource ToolTip_Slider_Level}" ValueChanged="Slider_Level_ValueChanged" />
          </Grid>
          <Grid Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Button Name="Btn_Reset" Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Button_Reset}" ToolTip="{DynamicResource ToolTip_Button_Reset}" Click="Btn_Reset_Click" />
          </Grid>
        </Grid>
        <Grid Row="1">
          <Image Style="{StaticResource Img_AINR_Style}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>