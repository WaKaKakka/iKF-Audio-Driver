<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.EQControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" xmlns:h="clr-namespace:XearONE.UI.Helpers" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="EQControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\EQControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <h:IntEqualToBooleanConverter x:Key="IntEqConverter" />
      <Style x:Key="EQSlider_Style" TargetType="{x:Type Slider}" BasedOn="{StaticResource EQSlider}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Slider.Orientation" Value="Vertical" />
        <Setter Property="RangeBase.Minimum" Value="-20" />
        <Setter Property="RangeBase.Maximum" Value="20" />
        <Setter Property="RangeBase.SmallChange" Value="1" />
        <Setter Property="RangeBase.LargeChange" Value="2" />
        <Setter Property="Slider.AutoToolTipPlacement" Value="TopLeft" />
      </Style>
      <ControlTemplate x:Key="RadioButton_Preset_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_RadioButton_Preset_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_RadioButton_Preset_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_RadioButton_Preset_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_Preset_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_Preset}">
        <Setter Property="Width" Value="75" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Preset" />
        <Setter Property="Template" Value="{StaticResource RadioButton_Preset_Template}" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Disable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="Button_Save_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Width="{TemplateBinding FrameworkElement.Width}" Height="{TemplateBinding FrameworkElement.Height}" Source="{StaticResource Img_Save_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Save_mo}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Save_di}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Save_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Save_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_Save}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Button_Save_Template}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_EQ}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" IsChecked="{Binding Enable}" />
      </Grid>
      <Grid Row="1" IsEnabled="{Binding Enable}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Image HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Panel_EQSlider_Bg}" />
          <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="250" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid Row="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
              </Grid.RowDefinitions>
              <Label Grid.Row="0" Content="+20 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
              <Label Grid.Row="1" Content="+10 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
              <Label Grid.Row="2" Content="+0 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
              <Label Grid.Row="3" Content="-10 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
              <Label Grid.Row="4" Content="-20 dB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            </Grid>
            <Slider Name="EQ_Slider1" Grid.Column="1" Tag="0" Style="{StaticResource EQSlider_Style}" Value="{Binding Band1}" />
            <Slider Name="EQ_Slider2" Grid.Column="2" Tag="1" Style="{StaticResource EQSlider_Style}" Value="{Binding Band2}" />
            <Slider Name="EQ_Slider3" Grid.Column="3" Tag="2" Style="{StaticResource EQSlider_Style}" Value="{Binding Band3}" />
            <Slider Name="EQ_Slider4" Grid.Column="4" Tag="3" Style="{StaticResource EQSlider_Style}" Value="{Binding Band4}" />
            <Slider Name="EQ_Slider5" Grid.Column="5" Tag="4" Style="{StaticResource EQSlider_Style}" Value="{Binding Band5}" />
            <Slider Name="EQ_Slider6" Grid.Column="6" Tag="5" Style="{StaticResource EQSlider_Style}" Value="{Binding Band6}" />
            <Slider Name="EQ_Slider7" Grid.Column="7" Tag="6" Style="{StaticResource EQSlider_Style}" Value="{Binding Band7}" />
            <Slider Name="EQ_Slider8" Grid.Column="8" Tag="7" Style="{StaticResource EQSlider_Style}" Value="{Binding Band8}" />
            <Slider Name="EQ_Slider9" Grid.Column="9" Tag="8" Style="{StaticResource EQSlider_Style}" Value="{Binding Band9}" />
            <Slider Name="EQ_Slider10" Grid.Column="10" Tag="9" Style="{StaticResource EQSlider_Style}" Value="{Binding Band10}" />
            <Label Grid.Row="1" Grid.Column="1" Content="31 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="2" Content="63 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="3" Content="125 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="4" Content="250 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="5" Content="500 Hz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="6" Content="1 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="7" Content="2 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="8" Content="4 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="9" Content="8 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
            <Label Grid.Row="1" Grid.Column="10" Content="16 KHz" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="12" Style="{StaticResource Label_Main_Style}" />
          </Grid>
        </Grid>
        <Grid Column="1">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="70" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <WrapPanel Width="180" Height="240" Margin="5,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" ItemWidth="90" ItemHeight="41">
              <RadioButton Name="RadioButton_Preset_00" Content="{DynamicResource ToolTip_RadioButton_00}" Style="{StaticResource RadioButton_Preset_Style}" Tag="0" ToolTip="{DynamicResource ToolTip_RadioButton_00}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=0, Mode=TwoWay}" Visibility="{Binding IsPreset00Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_01" Content="{DynamicResource ToolTip_RadioButton_01}" Style="{StaticResource RadioButton_Preset_Style}" Tag="1" ToolTip="{DynamicResource ToolTip_RadioButton_01}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=1, Mode=TwoWay}" Visibility="{Binding IsPreset01Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_02" Content="{DynamicResource ToolTip_RadioButton_02}" Style="{StaticResource RadioButton_Preset_Style}" Tag="2" ToolTip="{DynamicResource ToolTip_RadioButton_02}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=2, Mode=TwoWay}" Visibility="{Binding IsPreset02Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_03" Content="{DynamicResource ToolTip_RadioButton_03}" Style="{StaticResource RadioButton_Preset_Style}" Tag="3" ToolTip="{DynamicResource ToolTip_RadioButton_03}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=3, Mode=TwoWay}" Visibility="{Binding IsPreset03Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_04" Content="{DynamicResource ToolTip_RadioButton_04}" Style="{StaticResource RadioButton_Preset_Style}" Tag="4" ToolTip="{DynamicResource ToolTip_RadioButton_04}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=4, Mode=TwoWay}" Visibility="{Binding IsPreset04Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_05" Content="{DynamicResource ToolTip_RadioButton_05}" Style="{StaticResource RadioButton_Preset_Style}" Tag="5" ToolTip="{DynamicResource ToolTip_RadioButton_05}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=5, Mode=TwoWay}" Visibility="{Binding IsPreset05Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_06" Content="{DynamicResource ToolTip_RadioButton_06}" Style="{StaticResource RadioButton_Preset_Style}" Tag="6" ToolTip="{DynamicResource ToolTip_RadioButton_06}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=6, Mode=TwoWay}" Visibility="{Binding IsPreset06Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_07" Content="{DynamicResource ToolTip_RadioButton_07}" Style="{StaticResource RadioButton_Preset_Style}" Tag="7" ToolTip="{DynamicResource ToolTip_RadioButton_07}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=7, Mode=TwoWay}" Visibility="{Binding IsPreset07Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_08" Content="{DynamicResource ToolTip_RadioButton_08}" Style="{StaticResource RadioButton_Preset_Style}" Tag="8" ToolTip="{DynamicResource ToolTip_RadioButton_08}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=8, Mode=TwoWay}" Visibility="{Binding IsPreset08Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_09" Content="{DynamicResource ToolTip_RadioButton_09}" Style="{StaticResource RadioButton_Preset_Style}" Tag="9" ToolTip="{DynamicResource ToolTip_RadioButton_09}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=9, Mode=TwoWay}" Visibility="{Binding IsPreset09Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_10" Content="{DynamicResource ToolTip_RadioButton_10}" Style="{StaticResource RadioButton_Preset_Style}" Tag="10" ToolTip="{DynamicResource ToolTip_RadioButton_10}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=10, Mode=TwoWay}" Visibility="{Binding IsPreset10Visible, Converter={StaticResource BoolToVis}}" />
              <RadioButton Name="RadioButton_Preset_11" Content="{DynamicResource ToolTip_RadioButton_11}" Style="{StaticResource RadioButton_Preset_Style}" Tag="11" ToolTip="{DynamicResource ToolTip_RadioButton_11}" IsChecked="{Binding SelectedPreset, Converter={StaticResource IntEqConverter}, ConverterParameter=11, Mode=TwoWay}" Visibility="{Binding IsPreset11Visible, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
          </Grid>
          <Grid Row="1">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <ComboBox Name="ComboBox_Mode" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ComboBox_Mode}" ToolTip="{DynamicResource ToolTip_ComboBox_Profile}" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" DisplayMemberPath="{x:Null}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Width="90" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding name}" />
                      <Button Focusable="False" Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}" CommandParameter="{Binding}">
                        <FrameworkElement.Style>
                          <Style BasedOn="{StaticResource Button_Close_Style}" TargetType="{x:Type Button}">
                            <Setter Property="Width" Value="25" />
                            <Setter Property="Height" Value="25" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsDropDownOpen, Source={x:Reference ComboBox_Mode}}">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
              <Button Name="Button_Save" Style="{StaticResource Button_Save_Style}" ToolTip="{DynamicResource ToolTip_Button_Save}" IsEnabled="{Binding EnableSave}" Command="{Binding SaveCommand}" />
            </Grid>
            <Grid Row="1">
              <TextBox Name="TextBox_EQProfileName" Width="125" Height="25" Margin="10,0,0,0" Style="{StaticResource TextBox_Style}" ToolTip="{DynamicResource ToolTip_TextBox_ProfileName}" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>