<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.XearMagicVoiceControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="XearMagicVoiceControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\XearMagicVoiceControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="RadioButton_ModeMonster_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeMonster_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMonster_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMonster_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMonster_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeMonster_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_ModeMonster}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeMonster_Template}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_RadioButton_Monster}" />
      </Style>
      <ControlTemplate x:Key="RadioButton_ModeCartoon_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeCartoon_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeCartoon_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeCartoon_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeCartoon_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeCartoon_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_ModeCartoon}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeCartoon_Template}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_RadioButton_Cartoon}" />
      </Style>
      <ControlTemplate x:Key="RadioButton_ModeMan_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeMan_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMan_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMan_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMan_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeMan_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_ModeMan}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeMan_Template}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_RadioButton_Man}" />
      </Style>
      <ControlTemplate x:Key="RadioButton_ModeWoman_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeWoman_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeWoman_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeWoman_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeWoman_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeWoman_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_ModeWoman}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeWoman_Template}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_RadioButton_Woman}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_XearMagicVoice}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" Height="200" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" />
          <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="{DynamicResource Label_Mode}" VerticalAlignment="Center" Margin="100,0,0,0" FontSize="18" Style="{StaticResource Label_Main_Style}" ToolTip="Surround room size" />
        <Grid Row="1" Width="500">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <RadioButton Name="RadioButton_ModeMonster" Grid.Column="0" Tag="0" Style="{StaticResource RadioButton_ModeMonster_Style}" Click="Btn_Mode_Click" />
          <RadioButton Name="RadioButton_ModeCartoon" Grid.Column="1" Tag="1" Style="{StaticResource RadioButton_ModeCartoon_Style}" Click="Btn_Mode_Click" />
          <RadioButton Name="RadioButton_ModeMan" Grid.Column="2" Tag="2" Style="{StaticResource RadioButton_ModeMan_Style}" Click="Btn_Mode_Click" />
          <RadioButton Name="RadioButton_ModeWoman" Grid.Column="3" Tag="3" Style="{StaticResource RadioButton_ModeWoman_Style}" Click="Btn_Mode_Click" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>