<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.XearVoiceClarityControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="XearVoiceClarityControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\XearVoiceClarityControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground Grid.RowSpan="3" Grid.ColumnSpan="3" />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_XearVoiceClarity}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" Height="200" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="1*" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.5*" />
          </Grid.ColumnDefinitions>
          <Grid Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{DynamicResource Label_VoiceClarityLevel}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
            <Slider Name="Slider_Level" Grid.Row="1" VerticalAlignment="Center" Minimum="0" Maximum="10" SmallChange="1" AutoToolTipPlacement="BottomRight" Style="{StaticResource Slider_Horizontal_Style}" ValueChanged="Slider_Level_ValueChanged" />
          </Grid>
          <Grid Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Rect_EffectPropertyValue}" />
            <Label Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_EffectPropertyValue}" Content="{Binding ElementName=Slider_Level, Path=Value}" />
            <Button Name="Btn_Reset_Level" Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Button_Reset}" ToolTip="{DynamicResource ToolTip_Button_Reset}" Click="Btn_Reset_Level_Click" />
          </Grid>
        </Grid>
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.5*" />
          </Grid.ColumnDefinitions>
          <Grid Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{DynamicResource Label_NSLevel}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
            <Slider Name="Slider_NS" Grid.Row="1" VerticalAlignment="Center" Minimum="0" Maximum="20" SmallChange="1" AutoToolTipPlacement="BottomRight" Style="{StaticResource Slider_Horizontal_Style}" Ticks="0,5,10,15,20" ValueChanged="Slider_NS_ValueChanged" />
          </Grid>
          <Grid Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="1*" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Rect_EffectPropertyValue}" />
            <Label Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_EffectPropertyValue}" Content="{Binding ElementName=Slider_NS, Path=Value}" />
            <Label Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Content="dB" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_dB}" />
            <Button Name="Btn_Reset_NS" Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Button_Reset}" ToolTip="{DynamicResource ToolTip_Button_Reset}" Click="Btn_Reset_NS_Click" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>