          <RadioButton Name="RadioButton_CounterClockwise" Grid.Row="1" Style="{StaticResource RadioButton_CounterClockwise_Style}" Tag="1" Click="Button_DragMode_Click" />
          <RadioButton Name="RadioButton_ManualClockwise" Grid.Row="2" Style="{StaticResource RadioButton_ManualClockwise_Style}" Tag="2" Click="Button_DragMode_Click" />
          <RadioButton Name="RadioButton_Manual" Grid.Row="3" Style="{StaticResource RadioButton_Manual_Style}" Tag="3" Click="Button_DragMode_Click" />
          <Button Name="Button_Reset" Grid.Row="4" Style="{StaticResource Button_Reset_Style}" Click="Button_Reset_Click" />
