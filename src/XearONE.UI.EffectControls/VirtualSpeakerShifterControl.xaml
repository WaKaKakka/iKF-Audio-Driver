            <Rectangle Width="280" Height="280" Stroke="#FFFFFFFF" StrokeThickness="1" Visibility="Collapsed" />
            <local:SpeakerButton x:Name="Button_Speaker_L" PreviewMouseDown="Speaker_ButtonDown" PreviewMouseMove="Speaker_Move" PreviewMouseUp="Speaker_ButtonUp" Style="{StaticResource Button_Speaker_L_Style}" Canvas.Left="37" Canvas.Top="37" Tag="0" />
