                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <RadioButton Name="RadioButton_MusicGamingMode" Grid.Column="0" Tag="0" Style="{StaticResource RadioButton_ModeMusicGaming_Style}" Click="Btn_SurroundHeadphoneMode_Click" />
              <RadioButton Name="RadioButton_MovieMode" Grid.Column="1" Tag="1" Style="{StaticResource RadioButton_ModeMovie_Style}" Click="Btn_SurroundHeadphoneMode_Click" />
            </Grid>
          </Grid>
          <Grid Row="1">
