              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Label Grid.Column="1" Content="{DynamicResource Label_EffectMode}" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" ToolTip="{DynamicResource ToolTip_EffectMode}" />
            <Grid Row="1">
              <Grid.ColumnDefinitions>
