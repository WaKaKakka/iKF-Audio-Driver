              <RowDefinition Height="40" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Label Grid.Column="1" Content="{DynamicResource Label_RoomSize}" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" ToolTip="{DynamicResource ToolTip_RoomSize}" />
            <Grid Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <RadioButton Name="RadioButton_RoomSizeSmall" Grid.Column="0" Tag="2" Style="{StaticResource RadioButton_RoomSizeSmall_Style}" Click="Btn_SurroundHeadphoneRoomSize_Click" />
              <RadioButton Name="RadioButton_RoomSizeMedium" Grid.Column="1" Tag="1" Style="{StaticResource RadioButton_RoomSizeMedium_Style}" Click="Btn_SurroundHeadphoneRoomSize_Click" />
              <RadioButton Name="RadioButton_RoomSizeLarge" Grid.Column="2" Tag="0" Style="{StaticResource RadioButton_RoomSizeLarge_Style}" Click="Btn_SurroundHeadphoneRoomSize_Click" />
            </Grid>
          </Grid>
        </Grid>
        <Grid Column="1">
          <Image Grid.RowSpan="3" Grid.ColumnSpan="3" Source="{StaticResource Img_Diagram_Bg}" />
          <CheckBox Name="CheckBox_L" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="0" Style="{StaticResource CheckBox_L_Style}" Click="CheckBox_Speaker_Click" />
          <CheckBox Name="CheckBox_R" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="1" Style="{StaticResource CheckBox_R_Style}" Click="CheckBox_Speaker_Click" />
          <CheckBox Name="CheckBox_C" HorizontalAlignment="Center" VerticalAlignment="Top" Tag="2" Style="{StaticResource CheckBox_C_Style}" Visibility="{Binding ElementName=Btn_Enable, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}" Click="CheckBox_Speaker_Click" />
          <CheckBox Name="CheckBox_W" HorizontalAlignment="Center" VerticalAlignment="Top" Tag="3" Style="{StaticResource CheckBox_W_Style}" Visibility="{Binding ElementName=Btn_Enable, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}" Click="CheckBox_Speaker_Click" />
          <CheckBox Name="CheckBox_LS" HorizontalAlignment="Left" VerticalAlignment="Center" Tag="6" Style="{StaticResource CheckBox_LS_Style}" Visibility="{Binding ElementName=Btn_Enable, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}" Click="CheckBox_Speaker_Click" />
