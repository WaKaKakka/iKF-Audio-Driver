<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.XearAudioBrilliantControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="XearAudioBrilliantControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\XearAudioBrilliantControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_XearAudioBrilliant}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" Height="100" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>
        <Grid Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Content="{DynamicResource Label_BrilliantLevel}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Slider Name="Slider_Level" Grid.Row="1" VerticalAlignment="Center" Minimum="0" Maximum="10" SmallChange="1" AutoToolTipPlacement="BottomRight" Style="{StaticResource Slider_Horizontal_Style}" ValueChanged="Slider_Level_ValueChanged" />
        </Grid>
        <Grid Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>
          <Rectangle Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Rect_EffectPropertyValue}" />
          <Label Name="Label_LevelValue" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_EffectPropertyValue}" Content="{Binding ElementName=Slider_Level, Path=Value}" />
          <Button Name="Btn_Reset" Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource Button_Reset}" ToolTip="{DynamicResource ToolTip_Button_Reset}" Click="Btn_Reset_Click" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>