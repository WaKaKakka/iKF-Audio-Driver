<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.XearSmartVolumeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" Width="780" Height="400" MinWidth="780" MinHeight="400" MaxWidth="780" MaxHeight="400" Loaded="XearSmartVolumeControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\XearSmartVolumeControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Img_SmartVolume_Style" TargetType="{x:Type Image}" BasedOn="{StaticResource Img_SmartVolume}">
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="True">
            <Setter Property="Source" Value="{StaticResource Img_SmartVolume_on}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Source" Value="{StaticResource Img_SmartVolume_off}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="RadioButton_ModeMusic_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeMusic_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMusic_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMusic_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeMusic_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeMusic_Style" TargetType="{x:Type RadioButton}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeMusic_Template}" />
        <Setter Property="RadioButton.GroupName" Value="Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_RadioButton_Music}" />
      </Style>
      <ControlTemplate x:Key="RadioButton_ModeSpeech_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ModeSpeech_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeSpeech_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeSpeech_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ModeSpeech_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_ModeSpeech_Style" TargetType="{x:Type RadioButton}">
        <Setter Property="Template" Value="{StaticResource RadioButton_ModeSpeech_Template}" />
        <Setter Property="RadioButton.GroupName" Value="Mode" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_RadioButton_Speech}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <local:EffectControlBackground />
    <Grid Margin="15,15,15,15">
      <Grid.RowDefinitions>
        <RowDefinition Height="60" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="10,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_XearSmartVolume}" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="Btn_Enable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="Btn_Enable_Click" />
      </Grid>
      <Grid Row="1" IsEnabled="{Binding ElementName=Btn_Enable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="90" />
          <RowDefinition Height="60" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Image Style="{StaticResource Img_SmartVolume_Style}" />
        </Grid>
        <Grid Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid Column="0">
              <Rectangle Grid.Row="1" Style="{StaticResource Rect_EffectPropertyValue}" />
              <Label Name="Label_LevelValue" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_EffectPropertyValue}" Content="{Binding ElementName=Slider_Level, Path=Value}" />
            </Grid>
            <Grid Column="1">
              <Image HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Img_SliderBackground}" />
              <Slider Name="Slider_Level" Grid.Column="0" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" AutoToolTipPlacement="BottomRight" Style="{StaticResource Slider_Horizontal_Style}" ValueChanged="Slider_Level_ValueChanged" />
            </Grid>
            <Button Name="Btn_Reset" Grid.Column="2" HorizontalAlignment="Center" Style="{StaticResource Button_Reset}" ToolTip="{DynamicResource ToolTip_Button_Reset}" Click="Btn_Reset_Click" />
          </Grid>
        </Grid>
        <Grid Row="2" Width="320">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="110" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <RadioButton Name="RadioButton_Music_Mode" Grid.Column="0" HorizontalAlignment="Center" Style="{StaticResource RadioButton_ModeMusic_Style}" Tag="0" Checked="RadioButton_Mode_Checked" />
              <RadioButton Name="RadioButton_Speech_Mode" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource RadioButton_ModeSpeech_Style}" Tag="1" Checked="RadioButton_Mode_Checked" />
            </Grid>
            <Grid Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <Label Grid.Column="0" Content="{DynamicResource Label_Music}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,17" FontSize="17" Style="{StaticResource Label_Main_Style}" />
              <Label Grid.Column="0" Content="{DynamicResource Label_Music_Info}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,17,0,0" FontSize="12" Style="{StaticResource Label_Sub_Style}" />
              <Label Grid.Column="1" Content="{DynamicResource Label_Speech}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,17" FontSize="17" Style="{StaticResource Label_Main_Style}" />
              <Label Grid.Column="1" Content="{DynamicResource Label_Speech_Info}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,17,0,0" FontSize="12" Style="{StaticResource Label_Sub_Style}" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>