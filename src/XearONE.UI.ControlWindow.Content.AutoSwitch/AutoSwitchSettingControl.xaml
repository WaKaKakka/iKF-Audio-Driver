<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.ControlWindow.Content.AutoSwitch.AutoSwitchSettingControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.ControlWindow.Content.AutoSwitch" Width="450" Height="400" Loaded="AutoSwitchSettingControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\ControlWindow\AutoSwitchStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="Button_Icon_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_Icon_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Icon_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Icon_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_Icon}">
        <Setter Property="Template" Value="{StaticResource Button_Icon_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_Button_Icon}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="30">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
        <RowDefinition Height="60" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Content="Widget Name" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
          <TextBox Name="TextBox_WidgetName" Grid.Row="1" Height="30" Width="150" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontSize="20" Style="{StaticResource TextBox_Style}" Text="{Binding widgetName}" />
          <Border Name="Border_ErrorWidgetName" Grid.Row="1" Height="30" Width="150" HorizontalAlignment="Left" BorderBrush="#FFFF0000" BorderThickness="2" CornerRadius="6" Visibility="Hidden" />
        </Grid>
        <Grid Column="1">
          <Image Name="Image_Icon" Width="80" Height="80" />
          <Button Name="Button_Icon" Width="90" Height="90" Style="{StaticResource Button_Icon_Style}" Click="Button_Icon_Click" />
        </Grid>
      </Grid>
      <Grid Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Application Location" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <Grid Row="1">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBox Name="TextBox_AppPath" Height="30" Width="300" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontSize="18" Style="{StaticResource TextBox_Style}" Text="{Binding appPath}" />
            <Border Name="Border_ErrorAppLocation" Height="30" Width="300" HorizontalAlignment="Left" Margin="-300,0,0,0" BorderBrush="#FFFF0000" BorderThickness="2" CornerRadius="6" Visibility="Hidden" />
            <Button Name="Button_Browser" Width="40" Height="30" Margin="30,0,0,0" Content="..." Click="Button_Browser_Click" />
          </StackPanel>
        </Grid>
      </Grid>
      <Grid Row="2">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Binding Profile" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <ComboBox Name="ComboBox_Profile" Grid.Row="1" Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource ComboBox_Style}" />
      </Grid>
      <Button Name="Button_Save" Grid.Row="3" Width="80" Height="40" Content="Save" Click="Button_Save_Click" />
    </Grid>
  </Grid>
</UserControl>