<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.EffectControls.RecordingEffect.RecordingEffectControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.EffectControls" xmlns:recordingeffect="clr-namespace:XearONE.UI.EffectControls.RecordingEffect" Loaded="RecordingEffectControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\SoundEffects\RecordingEffectControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="RadioButton_AINR_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_AINR_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_AINR_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_AINR_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_AINR_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_AINR_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_AINR}">
        <Setter Property="Template" Value="{StaticResource RadioButton_AINR_Template}" />
        <Setter Property="RadioButton.GroupName" Value="NoiseReductionMode" />
      </Style>
      <ControlTemplate x:Key="RadioButton_Compressor_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_Compressor_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Compressor_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Compressor_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Compressor_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_Compressor_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_Compressor}">
        <Setter Property="Template" Value="{StaticResource RadioButton_Compressor_Template}" />
        <Setter Property="RadioButton.GroupName" Value="NoiseReductionMode" />
      </Style>
      <ControlTemplate x:Key="RadioButton_LDR_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_LDR_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_LDR_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_LDR_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_LDR_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_LDR_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_LDR}">
        <Setter Property="Template" Value="{StaticResource RadioButton_LDR_Template}" />
        <Setter Property="RadioButton.GroupName" Value="NoiseReductionMode" />
      </Style>
      <ControlTemplate x:Key="RadioButton_Preset_Template" TargetType="{x:Type RadioButton}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_RadioButton_Preset_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_RadioButton_Preset_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_RadioButton_Preset_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="RadioButton_Preset_Style" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource RadioButton_Preset}">
        <Setter Property="Width" Value="75" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template" Value="{StaticResource RadioButton_Preset_Template}" />
        <Setter Property="RadioButton.GroupName" Value="GroupName_Preset" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Disable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="15" />
      <RowDefinition />
      <RowDefinition Height="15" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="15" />
      <ColumnDefinition Width="750" />
      <ColumnDefinition Width="15" />
    </Grid.ColumnDefinitions>
    <local:EffectControlBackground x:Name="Bg" Grid.RowSpan="3" Grid.ColumnSpan="3" />
    <Grid Row="1" Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="10" />
        <RowDefinition Height="220" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Content="{DynamicResource Label_Title_RecordingEffect}" Grid.Column="0" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20" Style="{StaticResource Label_Main_Style}" />
        <CheckBox Name="tbNoiseReductionEnable" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource CheckBox_EffectControlSwitch_Style}" Click="NoiseReductionEnable_Click" />
      </Grid>
      <Grid Row="2" IsEnabled="{Binding ElementName=tbNoiseReductionEnable, Path=IsChecked}">
        <Grid.RowDefinitions>
          <RowDefinition Height="174" />
          <RowDefinition Height="24" />
          <RowDefinition Height="22" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="175" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="175" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="175" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <RadioButton Name="rbAINR" GroupName="NoiseReductionMode" Grid.Row="0" Grid.Column="1" Style="{StaticResource RadioButton_AINR_Style}" Click="AINR_Click" />
        <RadioButton Name="rbCompressor" GroupName="NoiseReductionMode" Grid.Row="0" Grid.Column="3" Style="{StaticResource RadioButton_Compressor_Style}" Click="Compressor_Click" />
        <RadioButton Name="rbLDR" GroupName="NoiseReductionMode" Grid.Row="0" Grid.Column="5" Style="{StaticResource RadioButton_LDR_Style}" Click="LDR_Click" />
        <Label Grid.Row="1" Grid.Column="1" Content="{DynamicResource RecordingEffect_Label_AINR}" HorizontalAlignment="Center" FontSize="12" Margin="0,-4,0,0" Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="1" Grid.Column="3" Content="{DynamicResource RecordingEffect_Label_Compressor}" HorizontalAlignment="Center" FontSize="12" Margin="0,-4,0,0                        " Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="1" Grid.Column="5" Content="{DynamicResource RecordingEffect_Label_LDR}" HorizontalAlignment="Center" FontSize="12" Margin="0,-4,0,0" Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="2" Grid.Column="1" Content="{DynamicResource RecordingEffect_Label_VoiceOnly}" HorizontalAlignment="Center" FontSize="10" Margin="0,-4,0,-2" Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="2" Grid.Column="3" Content="{DynamicResource RecordingEffect_Label_Balance}" HorizontalAlignment="Center" FontSize="10" Margin="0,-4,0,-2" Style="{StaticResource Label_Main_Style}" />
        <Label Grid.Row="2" Grid.Column="5" Content="{DynamicResource RecordingEffect_Label_Maximum}" HorizontalAlignment="Center" FontSize="10" Margin="0,-4,0,-2" Style="{StaticResource Label_Main_Style}" />
      </Grid>
      <Grid Name="grdNoiseGateDetails" Row="3" Width="640">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="150" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <Slider Name="slCompressorThreshold" Grid.Row="1" Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" Minimum="6" Maximum="40" Value="6" Style="{StaticResource Slider_Vertical_Style}" ValueChanged="Compressor_ValueChanged" />
          <Slider Name="slCompressorRatio" Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" Minimum="4" Maximum="10" Value="4" Style="{StaticResource Slider_Vertical_Style}" ValueChanged="Compressor_ValueChanged" />
          <Slider Name="slCompressorWidth" Grid.Row="1" Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="20" Value="0" Style="{StaticResource Slider_Vertical_Style}" ValueChanged="Compressor_ValueChanged" />
          <Slider Name="slCompressorAttackTime" Grid.Row="1" Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Center" Minimum="2" Maximum="10" Value="2" Style="{StaticResource Slider_Vertical_Style}" ValueChanged="Compressor_ValueChanged" />
          <Slider Name="slCompressorReleaseTime" Grid.Row="1" Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Center" Minimum="100" Maximum="500" Value="100" Style="{StaticResource Slider_Vertical_Style}" ValueChanged="Compressor_ValueChanged" />
          <Slider Name="slCompressorGain" Grid.Row="1" Grid.Column="5" Orientation="Vertical" HorizontalAlignment="Center" Minimum="0" Maximum="40" Value="0" Style="{StaticResource Slider_Vertical_Style}" ValueChanged="Compressor_ValueChanged" />
          <Label Grid.Row="0" Grid.Column="0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" Content="{Binding ElementName=slCompressorThreshold, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0#}" />
          <Label Grid.Row="0" Grid.Column="1" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" Content="{Binding ElementName=slCompressorRatio, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0#}" />
          <Label Grid.Row="0" Grid.Column="2" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" Content="{Binding ElementName=slCompressorWidth, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0#}" />
          <Label Grid.Row="0" Grid.Column="3" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" Content="{Binding ElementName=slCompressorAttackTime, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0#}" />
          <Label Grid.Row="0" Grid.Column="4" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" Content="{Binding ElementName=slCompressorReleaseTime, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0#}" />
          <Label Grid.Row="0" Grid.Column="5" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" Content="{Binding ElementName=slCompressorGain, Path=Value, UpdateSourceTrigger=PropertyChanged, StringFormat=0#}" />
          <Label Grid.Row="2" Grid.Column="0" Content="Threshold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="2" Grid.Column="1" Content="Ratio" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="2" Grid.Column="2" Content="Width" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="2" Grid.Column="3" Content="Attack Time" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="2" Grid.Column="4" Content="Release Time" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="2" Grid.Column="5" Content="Gain" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Grid Row="1" Column="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <RadioButton Name="RadioButtonCompressorMax" Grid.Row="0" Content="{DynamicResource RecordingEffect_RadioButton_CompressorMax}" Style="{StaticResource RadioButton_Preset_Style}" Checked="CompressorPreset_Checked" />
            <RadioButton Name="RadioButtonCompressorDefault" Grid.Row="1" Content="{DynamicResource RecordingEffect_RadioButton_CompressorDefault}" Style="{StaticResource RadioButton_Preset_Style}" Checked="CompressorPreset_Checked" />
            <RadioButton Name="RadioButtonCompressorLow" Grid.Row="2" Content="{DynamicResource RecordingEffect_RadioButton_CompressorLow}" Style="{StaticResource RadioButton_Preset_Style}" Checked="CompressorPreset_Checked" />
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>