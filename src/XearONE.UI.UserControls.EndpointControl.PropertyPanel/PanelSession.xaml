<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelSession" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="250" MinHeight="20" MaxWidth="250" MaxHeight="20" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelSessionStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Width="250" Height="20" Source="{StaticResource Img_Session_Bg}" />
    <Border Name="Border_IsCMDevice" CornerRadius="10" BorderThickness="1" Style="{StaticResource Border_Gaming}" />
    <Canvas Width="240" Height="20" ClipToBounds="True">
      <Label Name="Label_JackSession" Content="Idle, ..." HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" Style="{StaticResource Label_Sub_Style}" FontSize="12" ToolTip="{DynamicResource ToolTip_Session}" SizeChanged="Label_SizeChanged" />
    </Canvas>
  </Grid>
</UserControl>