<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelVolume" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="50" MinHeight="310" MaxWidth="50" MaxHeight="310" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelVolumeStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="CheckBox_UnitChange_Template" TargetType="{x:Type CheckBox}">
        <Grid>
          <Rectangle Name="Rect" RadiusX="2" RadiusY="2" StrokeThickness="0">
            <Shape.Fill>
              <SolidColorBrush Color="#00FFFFFF" />
            </Shape.Fill>
            <Shape.Stroke>
              <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
            </Shape.Stroke>
          </Rectangle>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Rect" Property="Shape.StrokeThickness" Value="1" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CheckBox_UnitChange_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox_UnitChange}">
        <Setter Property="Template" Value="{StaticResource CheckBox_UnitChange_Template}" />
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_UnitChange_LV}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_UnitChange_dB}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="1*" />
      <RowDefinition Height="200" />
      <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <Label Name="Label_Percentage" Grid.Row="0" Height="32" Width="35" Content="%" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource Label_Main_Style}" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
    <CheckBox Name="CheckBox_UnitChange" Grid.Row="0" Height="32" Width="35" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource CheckBox_UnitChange_Style}" Click="CheckBox_UnitChange_Click" />
    <Grid Row="1">
      <Image Width="45" Height="185" Source="{StaticResource Img_Volume_Bg}" />
      <Border Name="Border_IsCMDevice" Width="45" Height="185" CornerRadius="5" BorderThickness="1" Style="{StaticResource Border_Gaming}" />
      <Image Width="45" Height="185" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource Img_Volume_Tick}" />
      <Slider Name="Slider_MasterVolume" HorizontalAlignment="Center" VerticalAlignment="Center" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Orientation="Vertical" ToolTipService.InitialShowDelay="0" Style="{StaticResource Slider_Volume}" ToolTip="{DynamicResource ToolTip_Slider_MasterVolume}" ValueChanged="Slider_MasterVolume_ValueChanged" />
    </Grid>
    <Label Name="Label_VolumeLevel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource Label_Main_Style}" FontSize="22" HorizontalContentAlignment="Center" />
  </Grid>
</UserControl>