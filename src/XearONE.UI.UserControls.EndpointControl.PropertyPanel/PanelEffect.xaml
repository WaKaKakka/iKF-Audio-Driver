<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelEffect" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" Width="106" Height="285" MinWidth="106" MinHeight="285" MaxWidth="106" MaxHeight="285" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelEffectStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="CheckBox_EffectSwitch_Template" TargetType="{x:Type CheckBox}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_EffectSwitch_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectSwitch_mo}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectSwitch_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectSwitch_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CheckBox_EffectSwitch_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox_EffectSwitch}">
        <Setter Property="Template" Value="{StaticResource CheckBox_EffectSwitch_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_EffectSwitch}" />
      </Style>
      <ControlTemplate x:Key="Button_EffectSetting_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_EffectSetting_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectSetting_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectSetting_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectSetting_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_EffectSetting_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_EffectSetting}">
        <Setter Property="Template" Value="{StaticResource Button_EffectSetting_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_Button_EffectSetting}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Width="106" Height="285" Source="{StaticResource Img_Effect_Bg}" />
    <Border Name="Border_IsCMDevice" CornerRadius="10" BorderThickness="1" Style="{StaticResource Border_Gaming}" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="4*" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <CheckBox Name="CheckBox_EffectSwitch" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0" ToolTipService.InitialShowDelay="0" Style="{StaticResource CheckBox_EffectSwitch_Style}" Click="CheckBox_EffectSwitch_Click" />
        <Button Name="Button_EffectSetting" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" Style="{StaticResource Button_EffectSetting_Style}" IsEnabled="{Binding ElementName=CheckBox_EffectSwitch, Path=IsChecked}" Click="Button_EffectSetting_Click" />
      </Grid>
      <Grid Row="1" IsEnabled="{Binding ElementName=CheckBox_EffectSwitch, Path=IsChecked}">
        <ScrollViewer Margin="0,0,0,18" CanContentScroll="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="StackPanel_EffectButtonList" HorizontalAlignment="Center" CanVerticallyScroll="True" />
        </ScrollViewer>
      </Grid>
    </Grid>
    <Rectangle Name="Rect_EffectPanel_Disbale" RadiusX="10" RadiusY="10" StrokeThickness="1" ToolTip="{DynamicResource ToolTip_Rect_EffectPanel_Disbale}" Visibility="Hidden">
      <Shape.Fill>
        <SolidColorBrush Color="#50000000" />
      </Shape.Fill>
    </Rectangle>
  </Grid>
</UserControl>