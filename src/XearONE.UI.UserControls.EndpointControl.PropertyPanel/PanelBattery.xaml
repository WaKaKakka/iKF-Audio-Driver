<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelBattery" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="80" MinHeight="30" MaxWidth="80" MaxHeight="30" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelBatteryStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="Img_Battery_Style" TargetType="{x:Type Image}" BasedOn="{StaticResource Img_Battery}">
        <Setter Property="Source" Value="{StaticResource Img_BatteryLevel_00}" />
      </Style>
      <Style x:Key="Img_Battery_State_Style" TargetType="{x:Type Image}" BasedOn="{StaticResource Img_Battery_State}">
        <Setter Property="Source" Value="{StaticResource Img_BatteryState_NoInfo}" />
      </Style>
      <Style x:Key="Img_Battery_Disconnect_Style" TargetType="{x:Type Image}" BasedOn="{StaticResource Img_Battery_Disconnect}">
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_Img_Battery_Disconnect}" />
        <Setter Property="Source" Value="{StaticResource Img_Disconnect}" />
        <Style.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:1" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Grid_Content">
    <Image Name="Img_Battery" HorizontalAlignment="Right" Style="{StaticResource Img_Battery_Style}" />
    <Image Name="Img_Battery_State" HorizontalAlignment="Right" Style="{StaticResource Img_Battery_State_Style}" Visibility="Hidden" />
    <Image Name="Img_Battery_Disconnect" HorizontalAlignment="Right" Style="{StaticResource Img_Battery_Disconnect_Style}" Visibility="Hidden" />
    <Label Name="Label_Battery" Width="47" Height="23" HorizontalAlignment="Right" Margin="0,0,30,0" FontSize="11" HorizontalContentAlignment="Right" Style="{StaticResource Label_Sub_Style}" />
  </Grid>
</UserControl>