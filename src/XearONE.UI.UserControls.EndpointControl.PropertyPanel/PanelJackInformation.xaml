<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelJackInformation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="220" MinHeight="60" MaxWidth="220" MaxHeight="60" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelJackInformationStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="45" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
    <Grid Column="0">
      <Image Name="Img_JackIcon" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource Img_JackSpeaker}" Stretch="Fill" />
      <Image Name="Img_DefaultDevice" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,-20" />
    </Grid>
    <Grid Column="1">
      <Canvas Width="170" ClipToBounds="True">
        <Label Name="Label_JackName" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="5" FontSize="19" Style="{StaticResource Label_Main_Style}" Content="{Binding displayName}" ToolTip="{Binding displayName}" SizeChanged="Label_SizeChanged" />
        <Label Name="Label_JackInfo" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="30" FontSize="11" Style="{StaticResource Label_Sub_Style}" Content="{Binding controllerDisplayName}" ToolTip="{Binding controllerDisplayName}" SizeChanged="Label_SizeChanged" />
      </Canvas>
    </Grid>
  </Grid>
</UserControl>