<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelBalance" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="250" MinHeight="70" MaxWidth="250" MaxHeight="70" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelBalanceStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="RepeatButton_Slider_Balance_Style" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="#00FFFFFF" Width="123" Height="8" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Thumb_Balance_Style" TargetType="{x:Type Thumb}" BasedOn="{StaticResource Thumb_Balance}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Grid>
                <Image Name="Img" Source="{StaticResource Img_Thumb_Balance_no}" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Thumb_Balance_mo}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Thumb_Balance_di}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="Slider_Balance_Style" TargetType="{x:Type Slider}" BasedOn="{StaticResource Slider_Balance}">
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Name="TrackBackground" CornerRadius="4" Height="8" Grid.Row="1" BorderThickness="0.5">
                  <Border.BorderBrush>
                    <SolidColorBrush Color="#474F60" />
                  </Border.BorderBrush>
                  <Border.Background>
                    <SolidColorBrush Color="{StaticResource Color_SliderBg}" />
                  </Border.Background>
                </Border>
                <Rectangle Grid.Row="1" Width="1.5" Height="14" StrokeThickness="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Shape.Fill>
                    <SolidColorBrush Color="#5C6577" />
                  </Shape.Fill>
                </Rectangle>
                <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="False" Minimum="{TemplateBinding RangeBase.Minimum}" Maximum="{TemplateBinding RangeBase.Maximum}" Value="{TemplateBinding RangeBase.Value}">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#00000000" BorderBrush="#00000000" Foreground="#00000000" Style="{StaticResource RepeatButton_Slider_Balance_Style}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#00000000" BorderBrush="#00000000" Foreground="#00000000" Style="{StaticResource RepeatButton_Slider_Balance_Style}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource Thumb_Balance_Style}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Width="250" Height="70" Source="{StaticResource Img_Balance_Bg}" />
    <Border Name="Border_IsCMDevice" CornerRadius="10" BorderThickness="1" Style="{StaticResource Border_Gaming}" />
    <Grid Name="Grid_Balance">
      <Grid.RowDefinitions>
        <RowDefinition Height="1*" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Width="70" Content="{DynamicResource Label_Left}" HorizontalAlignment="Center" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="13" />
        <Image Name="Img_Balance_Icon" Grid.Column="1" Height="30" HorizontalAlignment="Center" VerticalAlignment="Bottom" Source="{StaticResource Img_Balance_Center}" />
        <Label Grid.Column="2" Width="70" Content="{DynamicResource Label_Right}" HorizontalAlignment="Center" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="13" />
      </Grid>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="123" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="42" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource Img_BalanceValue}" />
        <Label Name="Label_BalanceValueL" Grid.Column="0" Content="50%" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="14" />
        <Slider Name="Slider_Balance" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Maximum="20" SmallChange="1" IsSnapToTickEnabled="True" Style="{StaticResource Slider_Balance_Style}" ToolTip="{DynamicResource ToolTip_Slider_Balance}" ValueChanged="Slider_Balance_ValueChanged" />
        <Image Grid.Column="2" Width="42" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource Img_BalanceValue}" />
        <Label Name="Label_BalanceValueR" Grid.Column="2" Content="50%" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" FontSize="14" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>