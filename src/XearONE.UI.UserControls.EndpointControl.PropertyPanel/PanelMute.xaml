<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.PropertyPanel.PanelMute" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="45" MinHeight="45" MaxWidth="45" MaxHeight="45" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\PanelMuteStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="CheckBox_MutePlayback_Template" TargetType="{x:Type CheckBox}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_MutePlayback_no}" />
          <Image Name="stroke" Visibility="Hidden" Source="{StaticResource Img_Mute_mo}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="stroke" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_MutePlayback_se}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_MutePlayback_no}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CheckBox_MutePlayback_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox_MutePlayback}">
        <Setter Property="Template" Value="{StaticResource CheckBox_MutePlayback_Template}" />
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_Mute_Unmute}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_Mute_Mute}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="CheckBox_MuteCapture_Template" TargetType="{x:Type CheckBox}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_MuteCapture_no}" />
          <Image Name="stroke" Visibility="Hidden" Source="{StaticResource Img_Mute_mo}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="stroke" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_MuteCapture_se}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_MuteCapture_no}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CheckBox_MuteCapture_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox_MuteCapture}">
        <Setter Property="Template" Value="{StaticResource CheckBox_MuteCapture_Template}" />
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_Mute_Unmute}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_Mute_Mute}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <CheckBox Name="Button_Mute" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.InitialShowDelay="0" Style="{StaticResource CheckBox_MutePlayback_Style}" Click="Button_Mute_Click" />
  </Grid>
</UserControl>