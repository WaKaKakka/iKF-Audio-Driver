<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointListButtonControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls" Width="240" Height="40" Loaded="UserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\ControlWindow\EndpointListButtonControlStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="CheckBox_IsAdded_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox_IsAdded}">
        <Setter Property="Template" Value="{StaticResource CheckBox_Template}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_IsAdded_Remove}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_CheckBox_IsAdded_Add}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Width="240" Height="40" Source="{StaticResource Img_EndpointBg}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="43" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <CheckBox Name="CheckBox_IsAdded" Grid.Column="0" Style="{StaticResource CheckBox_IsAdded_Style}" IsChecked="{Binding IsAdded}" Click="CheckBox_IsAdded_Click" />
      <Grid Column="1" ToolTip="{Binding displayName}">
        <Label HorizontalAlignment="Left" VerticalAlignment="Center" Width="190" Height="30" Style="{StaticResource Label_Main_Style}" Margin="0,0,0,20" Content="{Binding displayName}" />
        <Label HorizontalAlignment="Left" VerticalAlignment="Center" Width="190" Height="30" Style="{StaticResource Label_Sub_Style}" FontSize="12" Margin="0,20,0,0" Content="{Binding controllerDisplayName}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>