<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.AutoSwitchItemControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls" Width="180" Height="200" Loaded="AutoSwitchItemControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\ControlWindow\AutoSwitchStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="Button_AutoSwitchSetting_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_AutoSwitchSetting_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_AutoSwitchSetting_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_AutoSwitchSetting_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_AutoSwitchSetting}">
        <Setter Property="Template" Value="{StaticResource Button_AutoSwitchSetting_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_Button_AutoSwitchSetting}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="1*" />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="3" RadiusX="10" RadiusY="10">
      <Shape.Fill>
        <SolidColorBrush Color="{StaticResource Color_Background}" />
      </Shape.Fill>
      <Shape.Stroke>
        <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
      </Shape.Stroke>
    </Rectangle>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="30" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="30" />
      </Grid.ColumnDefinitions>
      <Label Name="Label_WidgetName" Grid.Column="1" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Style="{StaticResource Label_Main_Style}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{Binding widgetName}" />
      <Button Name="Button_Delete" Grid.Column="2" Width="30" Height="30" Style="{StaticResource Button_Close_Style}" Click="Button_Delete_Click" />
    </Grid>
    <Grid Row="1">
      <Image Name="Image_AppIcon" Width="100" Height="100" Stretch="UniformToFill" />
      <Button Name="Button_AutoSwitchSetting" Grid.Column="1" Width="120" Height="120" Style="{StaticResource Button_AutoSwitchSetting_Style}" Click="Button_AutoSwitchSetting_Click" />
    </Grid>
    <Grid Row="2">
      <Label Name="Label_ProfileName" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Style="{StaticResource Label_Sub_Style}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{Binding bindingProfileName}" />
    </Grid>
  </Grid>
</UserControl>