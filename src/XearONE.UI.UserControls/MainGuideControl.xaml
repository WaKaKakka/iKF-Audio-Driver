<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.MainGuideControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls" Width="1366" Height="768" Loaded="MainGuideControl_Loaded">
  <Grid>
    <Image Name="Img_Main_Guide_Bg" Width="1366" Height="768" Source="pack://siteoforigin:,,,/Resources/Skin/Images/MainWindow/MainGuide/Img_Main_Guide_Bg01.png" Stretch="Fill" />
    <Rectangle>
      <Shape.Fill>
        <SolidColorBrush Color="#25000000" />
      </Shape.Fill>
    </Rectangle>
    <Image Name="Img_Main_Guide_Msg01" Source="pack://siteoforigin:,,,/Resources/Skin/Images/MainWindow/MainGuide/Img_Main_Guide_Msg01.png" Margin="318,111,747,575" />
    <Image Name="Img_Main_Guide_Msg02" Source="pack://siteoforigin:,,,/Resources/Skin/Images/MainWindow/MainGuide/Img_Main_Guide_Msg02.png" Margin="67,312,1110,384" />
    <Image Name="Img_Main_Guide_Msg03" Source="pack://siteoforigin:,,,/Resources/Skin/Images/MainWindow/MainGuide/Img_Main_Guide_Msg03.png" Margin="305,255,806,456" />
