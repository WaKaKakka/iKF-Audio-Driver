<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XearONE.UI.UserControls.EndpointControl.EndpointConsole" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:XearONE.UI.UserControls.EndpointControl" xmlns:panel="clr-namespace:XearONE.UI.UserControls.EndpointControl.PropertyPanel" MinWidth="310" MinHeight="583" MaxWidth="310" MaxHeight="583" Width="310" Height="583" Loaded="EndpointConsole_Loaded" Unloaded="EndpointConsole_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\EndpointControl\EndpointConsoleStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="Button_LED_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_LED_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_LED_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_LED_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_LED_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_LED}">
        <Setter Property="Template" Value="{StaticResource Button_LED_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_Button_LED}" />
      </Style>
      <ControlTemplate x:Key="Button_JackSetting_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_JackSetting_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_JackSetting_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_JackSetting_se}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_JackSetting_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_JackSetting}">
        <Setter Property="Template" Value="{StaticResource Button_JackSetting_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource ToolTip_Button_JackSetting}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Image Source="{StaticResource Img_EndpointConsole_Bg}" />
    <Border Name="Border_IsCMDevice" CornerRadius="10" BorderThickness="2" Style="{StaticResource Border_Gaming}" />
    <Button Name="Button_DeviceRemove" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Style="{StaticResource Button_Close_Style}" ToolTip="{DynamicResource ToolTip_Button_DeviceRemove}" Click="Button_DeviceRemove_Click" />
    <Grid Name="Grid_Content" Margin="30,0,30,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="33" />
        <RowDefinition Height="60" />
        <RowDefinition Height="20" />
        <RowDefinition Height="1*" />
        <RowDefinition Height="70" />
        <RowDefinition Height="15" />
        <RowDefinition Height="45" />
      </Grid.RowDefinitions>
      <Grid Name="Grid_DragArea" Row="0" PreviewMouseMove="Grid_DragArea_PreviewMouseMove" PreviewMouseLeftButtonDown="Grid_DragArea_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Grid_DragArea_PreviewMouseLeftButtonUp">
        <Rectangle Width="250" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="0" Cursor="SizeAll">
          <Shape.Fill>
            <SolidColorBrush Color="#00FFFFFF" />
          </Shape.Fill>
        </Rectangle>
      </Grid>
      <Grid Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Button Name="Button_LEDControl" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource Button_LED_Style}" Click="Button_LEDControl_Click" />
        <Grid Name="Grid_PanelBattery" Column="1" />
      </Grid>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <Grid Name="Grid_PanelJackInformation" Column="0" />
        <Grid Column="1">
          <Button Name="Button_JackSetting" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.InitialShowDelay="0" Style="{StaticResource Button_JackSetting_Style}" Click="Button_JackSetting_Click" />
        </Grid>
      </Grid>
      <Grid Name="Grid_PanelSession" Row="2" />
      <Grid Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <Grid Name="Grid_PanelVolume" Column="0" />
          <Grid Name="Grid_PanelPeakMeter" Column="1" />
        </Grid>
        <Grid Name="Grid_PanelEffect" Column="1" />
      </Grid>
      <Grid Name="Grid_PanelBalance" Row="4" />
      <Grid Name="Grid_PanelMute" Row="6" />
    </Grid>
  </Grid>
</UserControl>