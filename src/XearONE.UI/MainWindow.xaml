<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="XearONE.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:XearONE.UI" xmlns:sva="clr-namespace:XearONE.UI.ControlGraphicEffect" xmlns:GlobalProfile="clr-namespace:XearONE.UI.UserControls.GlobalProfile" Width="1366" Height="768" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="Manual" Left="50" Top="50" AllowsTransparency="True" Background="#00000000" Loaded="Window_Loaded" Closing="Window_Closing">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Skin\Styles\MainWindow\MainWindowStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="Button_App_Close_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_App_Close_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_App_Close_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_App_Close_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_App_Close}">
        <Setter Property="Template" Value="{StaticResource Button_App_Close_Template}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_App_Close}" />
      </Style>
      <ControlTemplate x:Key="Button_App_Minimize_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_App_Minimize_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_App_Minimize_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_App_Minimize_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_App_Minimize}">
        <Setter Property="Template" Value="{StaticResource Button_App_Minimize_Template}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_App_Minimize}" />
      </Style>
      <ControlTemplate x:Key="Button_App_Info_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_App_Info_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_App_Info_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_App_Info_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_App_Info}">
        <Setter Property="Template" Value="{StaticResource Button_App_Info_Template}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_App_Info}" />
      </Style>
      <ControlTemplate x:Key="Button_GlobalProfile_Template" TargetType="{x:Type Button}">
        <Grid>
          <Border Name="Background" CornerRadius="5" BorderThickness="1" Background="{StaticResource SolidColorBrush_RectButtonBackground}" BorderBrush="{StaticResource SolidColorBrush_Background_Stroke}" />
          <Label Content="Profile" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Width="{TemplateBinding FrameworkElement.Width}" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,0,5,0" FontSize="27" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Label Name="Label_ProfileName" Content="123" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Width="{TemplateBinding FrameworkElement.Width}" Height="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="5,0,5,0" FontSize="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource Label_Main_Style}" />
          <Border Name="stroke_se" Background="#00000000" CornerRadius="5" BorderThickness="4" Visibility="Hidden" Style="{StaticResource Border_Gaming}" />
          <Image Name="Img" Source="{StaticResource Img_GlobalProfile_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_GlobalProfile_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_GlobalProfile_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_GlobalProfile}">
        <Setter Property="Template" Value="{StaticResource Button_GlobalProfile_Template}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_GlobalProfile}" />
      </Style>
      <ControlTemplate x:Key="Button_ProfileAutoSwitch_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_ProfileAutoSwitch_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ProfileAutoSwitch_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ProfileAutoSwitch_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_ProfileAutoSwitch_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_ProfileAutoSwitch_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_ProfileAutoSwitch}">
        <Setter Property="Template" Value="{StaticResource Button_ProfileAutoSwitch_Template}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_ProfileAutoSwitch}" />
      </Style>
      <ControlTemplate x:Key="Button_AddDevice_Template" TargetType="{x:Type Button}">
        <Grid>
          <Border Width="50" Height="510" HorizontalAlignment="Right" CornerRadius="10,0,0,10" Background="#FF090F1A" BorderBrush="#FF191C21" BorderThickness="1" />
          <Image Name="Img" Source="{StaticResource Img_AddDevice_no}" Style="{StaticResource Button_AddDevice}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_AddDevice_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_AddDevice_Style" TargetType="{x:Type Button}">
        <Setter Property="Template" Value="{StaticResource Button_AddDevice_Template}" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="510" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_Add_Device}" />
        <Style.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
              <Storyboard>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" BeginTime="00:00:00">
                  <SplineThicknessKeyFrame KeyTime="00:00:00.2" Value="0,0,0,0" />
                </ThicknessAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
              <Storyboard>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetProperty="Margin" BeginTime="00:00:00">
                  <SplineThicknessKeyFrame KeyTime="00:00:00.2" Value="0,0,-20,0" />
                </ThicknessAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00000000" MouseDown="Grid_Main_MouseDown">
    <Rectangle Name="Rect_Background" Width="1366" Height="768" RadiusX="5" RadiusY="5">
      <Shape.Fill>
        <ImageBrush ImageSource="{StaticResource Img_MainBackground}" />
      </Shape.Fill>
    </Rectangle>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="140" />
        <RowDefinition Height="628" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="40,0,0,0" MouseDown="Grid_Main_MouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="400" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Image HorizontalAlignment="Left" ToolTip="{DynamicResource Tooltip_Img_BannerLogo}" Style="{StaticResource BannerLogo}" />
        </Grid>
        <Grid Column="1">
          <GlobalProfile:GlobalProfileControl x:Name="Button_Profile" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="90,0,0,0" Visibility="Hidden" />
          <Popup Name="ProfilePopup" Placement="Mouse" VerticalOffset="20" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=Button_GlobalProfile}" Opened="ProfilePopup_Opened" Closed="ProfilePopup_Closed">
            <GlobalProfile:ProfilePopupControl />
          </Popup>
          <Button Name="Button_ProfileAutoSwitch" Style="{StaticResource Button_ProfileAutoSwitch_Style}" Visibility="Hidden" Click="Button_ProfileAutoSwitch_Click" />
          <Button Name="Btn_Close" Style="{StaticResource Button_App_Close_Style}" Click="Btn_Close_Click" />
          <Button Name="Btn_Minimize" Style="{StaticResource Button_App_Minimize_Style}" Click="Btn_Minimize_Click" />
          <Button Name="Btn_Info" Style="{StaticResource Button_App_Info_Style}" Click="Btn_Info_Click" />
        </Grid>
        <Button Name="Btn_Test" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,0" Visibility="Hidden" Click="Btn_Test_Click" />
      </Grid>
      <Grid Name="Grid_DevicePanel" Row="1" Margin="26,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="67" />
        </Grid.ColumnDefinitions>
        <Grid Column="0">
          <Image HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Watermark}" />
          <sva:HScrollViewerAnimation Padding="0,0,-12,-5" Margin="0,1,1,1">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ScrollBar_H_Style}" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Canvas Name="EndpointControlCanvas" Background="#00000000" HorizontalAlignment="Left" />
          </sva:HScrollViewerAnimation>
        </Grid>
        <Grid Column="1">
          <Button Name="Btn_AddDevice" Margin="0,0,-20,0" Style="{StaticResource Button_AddDevice_Style}" Click="Btn_AddDevice_Click" />
        </Grid>
      </Grid>
      <StackPanel Name="Panel_GuideControl" Grid.RowSpan="2" />
    </Grid>
    <Border CornerRadius="4" BorderThickness="1.5" BorderBrush="{StaticResource SolidColorBrush_Border_Gaming}" />
  </Grid>
</Window>