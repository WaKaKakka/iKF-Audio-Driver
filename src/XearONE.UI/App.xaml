<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="XearONE.UI.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:XearONE.UI" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="\Resources\Language\en-US\en-US.xaml" />
        <ResourceDictionary Source="\Resources\Skin\Styles\CommonStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="SolidColorBrush_Background" Color="{StaticResource Color_Background}" />
      <SolidColorBrush x:Key="SolidColorBrush_Background_Stroke" Color="{StaticResource Color_Background_Stroke}" />
      <SolidColorBrush x:Key="SolidColorBrush_Background_Stroke_mo" Color="#FFB5C9FD" />
      <SolidColorBrush x:Key="SolidColorBrush_RectButtonBackground" Color="{StaticResource Color_RectButtonBackground}" />
      <SolidColorBrush x:Key="SolidColorBrush_Border_Gaming" Color="{StaticResource Color_Border_Gaming}" />
      <SolidColorBrush x:Key="SolidColorBrush_Label_Main" Color="{StaticResource Color_Label_Main}" />
      <SolidColorBrush x:Key="SolidColorBrush_Label_Sub" Color="{StaticResource Color_Label_Sub}" />
      <SolidColorBrush x:Key="SolidColorBrush_Disable" Color="{StaticResource Color_Disable}" />
      <SolidColorBrush x:Key="SolidColorBrush_FillFull" Color="{StaticResource Color_FillFull}" />
      <Style x:Key="Label_WindowTitle_Style" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Margin" Value="10,0,0,0" />
      </Style>
      <Style x:Key="Label_Main_Style" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
      </Style>
      <Style x:Key="Label_Sub_Style" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Sub}" />
      </Style>
      <ControlTemplate x:Key="Button_Close_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_Close_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Close_mo}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Close_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_Close}">
        <Setter Property="Template" Value="{StaticResource Button_Close_Template}" />
        <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_Button_Close}" />
      </Style>
      <ControlTemplate x:Key="Button_Reset_Template" TargetType="{x:Type Button}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_Reset_no}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Reset_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Reset_se}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_Reset_di}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Reset_Style" TargetType="{x:Type Button}" BasedOn="{StaticResource Button_Reset}">
        <Setter Property="Template" Value="{StaticResource Button_Reset_Template}" />
      </Style>
      <ControlTemplate x:Key="CheckBox_EffectControlSwitch_Template" TargetType="{x:Type CheckBox}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_EffectControlSwitch_no}" />
          <Image Name="stroke" Visibility="Hidden" Source="{StaticResource Img_EffectControlSwitch_mo}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="stroke" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectControlSwitch_se}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_EffectControlSwitch_no}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CheckBox_EffectControlSwitch_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox_EffectControlSwitch}">
        <Setter Property="Template" Value="{StaticResource CheckBox_EffectControlSwitch_Template}" />
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_CheckBox_EffectControlSwitch_Disable}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter Property="FrameworkElement.ToolTip" Value="{DynamicResource Tooltip_CheckBox_EffectControlSwitch_Enable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <ControlTemplate x:Key="CheckBox_Template" TargetType="{x:Type CheckBox}">
        <Grid>
          <Image Name="Img" Source="{StaticResource Img_CheckBox_no}" />
          <Image Name="stroke" Visibility="Hidden" Source="{StaticResource Img_CheckBox_mo}" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="stroke" Property="UIElement.Visibility" Value="Visible" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_CheckBox_se}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter TargetName="Img" Property="Image.Source" Value="{StaticResource Img_CheckBox_no}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="CheckBox_Style" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox}">
        <Setter Property="Template" Value="{StaticResource CheckBox_Template}" />
      </Style>
      <SolidColorBrush x:Key="SolidColorBrush_ToolTip_Text" Color="{StaticResource Color_ToolTip_Text}" />
      <Style x:Key="ToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="ToolTip.HasDropShadow" Value="False" />
        <Setter Property="ToolTip.Placement" Value="Right" />
        <Setter Property="ToolTip.HorizontalOffset" Value="8" />
        <Setter Property="ToolTip.VerticalOffset" Value="-16" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="UIElement.Opacity" Value="0" />
      </Style>
      <ControlTemplate x:Key="ToolTip_Template" TargetType="{x:Type ToolTip}">
        <Border Style="{StaticResource ToolTip_Border}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Offset="0" Color="{StaticResource Color_ToolTip_1}" />
              <GradientStop Offset="1" Color="{StaticResource Color_ToolTip_2}" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <TextBlock Text="{TemplateBinding ContentControl.Content}" FontSize="14" FontWeight="Bold" Opacity="0.9" TextWrapping="Wrap" Foreground="{StaticResource SolidColorBrush_ToolTip_Text}" />
          </Grid>
        </Border>
      </ControlTemplate>
      <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}" BasedOn="{StaticResource ToolTip}">
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="RenderTransform">
          <Setter.Value>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
          </Setter.Value>
        </Setter>
        <Setter Property="UIElement.RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template" Value="{StaticResource ToolTip_Template}" />
        <Style.Triggers>
          <EventTrigger RoutedEvent="ToolTip.Opened">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.9" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.95" To="1" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.95" To="1" Duration="0:0:0.2" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="ToolTip.Closed">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="0.95" Duration="0:0:0.2" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="0.95" Duration="0:0:0.2" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Style.Triggers>
      </Style>
      <Color x:Key="DisabledControlDarkColor">#FFC5CBF9</Color>
      <Color x:Key="DisabledForegroundColor">#FF888888</Color>
      <ControlTemplate x:Key="ComboBox_ToggleButton_Template" TargetType="{x:Type ToggleButton}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="25" />
          </Grid.ColumnDefinitions>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="MouseOver">
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource Color_Label_Main}" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Pressed" />
              <VisualState x:Name="Disabled">
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(BorderBrush).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource DisabledControlDarkColor}" />
                  </ColorAnimationUsingKeyFrames>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource DisabledForegroundColor}" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="CheckStates">
              <VisualState x:Name="Checked" />
              <VisualState x:Name="Unchecked" />
              <VisualState x:Name="Indeterminate" />
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Border Name="Border" Grid.ColumnSpan="2" CornerRadius="7" BorderThickness="0.5">
            <Border.BorderBrush>
              <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
            </Border.BorderBrush>
            <Border.Background>
              <SolidColorBrush Color="{StaticResource Color_FillFull}" />
            </Border.Background>
          </Border>
          <Border Name="ComboBackground" Grid.Column="0" CornerRadius="7,0,0,7" Margin="0.5">
            <Border.Background>
              <SolidColorBrush Color="{StaticResource Color_Background}" />
            </Border.Background>
          </Border>
          <Path Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,6 L8,0">
            <Shape.Fill>
              <SolidColorBrush Color="{StaticResource Color_Label_Main}" />
            </Shape.Fill>
          </Path>
        </Grid>
      </ControlTemplate>
      <ControlTemplate x:Key="ComboBox_TextBox_Template" TargetType="{x:Type TextBox}">
        <Border Name="PART_ContentHost" Focusable="False" Background="{TemplateBinding Control.Background}" />
      </ControlTemplate>
      <ControlTemplate x:Key="ComboBox_Template" TargetType="{x:Type ComboBox}">
        <Grid>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="MouseOver" />
              <VisualState x:Name="Disabled">
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="PART_EditableTextBox" Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource DisabledForegroundColor}" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="EditStates">
              <VisualState x:Name="Editable">
                <Storyboard>
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_EditableTextBox" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentSite" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Uneditable" />
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <ToggleButton Name="ToggleButton" Grid.Column="2" Focusable="False" ClickMode="Press" Template="{StaticResource ComboBox_ToggleButton_Template}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
          <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" Margin="7,3,23,3" VerticalAlignment="Stretch" HorizontalAlignment="Left" />
          <TextBox Name="PART_EditableTextBox" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,3,23,3" Focusable="True" Background="#00FFFFFF" Visibility="Hidden" IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}" Template="{StaticResource ComboBox_TextBox_Template}" Style="{x:Null}" />
          <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
            <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}">
              <Border Name="DropDownBorder" BorderThickness="1">
                <Border.BorderBrush>
                  <SolidColorBrush Color="{StaticResource Color_FillFull}" />
                </Border.BorderBrush>
                <Border.Background>
                  <SolidColorBrush Color="{StaticResource Color_Background}" />
                </Border.Background>
              </Border>
              <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
              </ScrollViewer>
            </Grid>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="ItemsControl.HasItems" Value="False">
            <Setter TargetName="DropDownBorder" Property="FrameworkElement.MinHeight" Value="95" />
          </Trigger>
          <Trigger Property="ItemsControl.IsGrouping" Value="True">
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
          </Trigger>
          <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="True">
            <Setter TargetName="DropDownBorder" Property="Border.CornerRadius" Value="6" />
            <Setter TargetName="DropDownBorder" Property="FrameworkElement.Margin" Value="0,2,0,0" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <ControlTemplate x:Key="ComboBoxItem_Template" TargetType="{x:Type ComboBoxItem}">
        <Border Name="Border" Padding="2" SnapsToDevicePixels="True" Background="#00FFFFFF" CornerRadius="6,6,6,6">
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="MouseOver">
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="{StaticResource Color_FillFull}" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionStates">
              <VisualState x:Name="Unselected" />
              <VisualState x:Name="Selected">
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="#30527AF5" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="SelectedUnfocused">
                <Storyboard>
                  <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)">
                    <EasingColorKeyFrame KeyTime="0" Value="#30527AF5" />
                  </ColorAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <ContentPresenter />
        </Border>
      </ControlTemplate>
      <Style x:Key="ComboBox_Style" TargetType="{x:Type ComboBox}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Setter Property="Template" Value="{StaticResource ComboBox_Template}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Disable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template" Value="{StaticResource ComboBoxItem_Template}" />
      </Style>
      <SolidColorBrush x:Key="SolidColorBrush_ScrollBar_Thumb" Color="{StaticResource Color_ScrollBar_Thumb}" />
      <Style x:Key="ScrollBar_H_Thumb_Style" TargetType="{x:Type Thumb}">
        <Setter Property="Height" Value="5" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border CornerRadius="5" BorderThickness="0" Background="{StaticResource SolidColorBrush_ScrollBar_Thumb}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Height" Value="10" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="RepeatButton_ScrollBar_H_Decrease_Style" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="#00FFFFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RepeatButton_ScrollBar_H_Increase_Style" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="#00FFFFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScrollBar_H_Style" TargetType="{x:Type ScrollBar}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition MaxWidth="5" />
                  <ColumnDefinition Width="0.00001*" />
                  <ColumnDefinition MaxWidth="5" />
                </Grid.ColumnDefinitions>
                <Track Name="PART_Track" Grid.Column="1" IsDirectionReversed="False" Minimum="{TemplateBinding RangeBase.Minimum}" Maximum="{TemplateBinding RangeBase.Maximum}" Value="{TemplateBinding RangeBase.Value}" Height="10">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#00000000" BorderBrush="#00000000" Foreground="#00000000" Style="{StaticResource RepeatButton_ScrollBar_H_Decrease_Style}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar_H_Thumb_Style}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#00000000" BorderBrush="#00000000" Foreground="#00000000" Style="{StaticResource RepeatButton_ScrollBar_H_Increase_Style}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScrollBar_V_Thumb_Style" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="6" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border CornerRadius="4" BorderThickness="0" Background="{StaticResource SolidColorBrush_ScrollBar_Thumb}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Width" Value="8" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="RepeatButton_ScrollBar_V_Decrease_Style" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="#00FFFFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="RepeatButton_ScrollBar_V_Increase_Style" TargetType="{x:Type RepeatButton}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="#00FFFFFF" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScrollBar_V_Style" TargetType="{x:Type ScrollBar}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition MaxHeight="7" />
                  <RowDefinition Height="0.00001*" />
                  <RowDefinition MaxHeight="7" />
                </Grid.RowDefinitions>
                <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Minimum="{TemplateBinding RangeBase.Minimum}" Maximum="{TemplateBinding RangeBase.Maximum}" Value="{TemplateBinding RangeBase.Value}" Width="8">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#00000000" BorderBrush="#00000000" Foreground="#00000000" Style="{StaticResource RepeatButton_ScrollBar_V_Decrease_Style}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBar_V_Thumb_Style}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#00000000" BorderBrush="#00000000" Foreground="#00000000" Style="{StaticResource RepeatButton_ScrollBar_V_Increase_Style}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Color x:Key="GlyphColor">#FF444444</Color>
      <SolidColorBrush x:Key="SolidColorBrush_SliderFull" Color="{StaticResource Color_SliderFull}" />
      <SolidColorBrush x:Key="SolidColorBrush_SliderStroke" Color="{StaticResource Color_SliderStroke}" />
      <SolidColorBrush x:Key="SolidColorBrush_SliderDisable" Color="{StaticResource Color_SliderDisable}" />
      <Style x:Key="Rect_RepeatButton_Top" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Margin" Value="0,0,0,-5" />
        <Setter Property="Rectangle.RadiusX" Value="4" />
        <Setter Property="Rectangle.RadiusY" Value="4" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Fill" Value="#00000000" />
      </Style>
      <Style x:Key="Rect_RepeatButton_Bottom" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Margin" Value="0,-5,0,0" />
        <Setter Property="Rectangle.RadiusX" Value="4" />
        <Setter Property="Rectangle.RadiusY" Value="4" />
