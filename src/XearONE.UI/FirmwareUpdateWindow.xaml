<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="XearONE.UI.FirmwareUpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:XearONE.UI" Title="FirmwareUpdateWindow" Width="600" Height="600" ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="None" Loaded="Window_Loaded" Closing="Window_Closing">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="Button_Template" TargetType="{x:Type Button}">
        <Grid>
          <Rectangle Name="Rect" RadiusX="5" RadiusY="5" StrokeThickness="1">
            <Shape.Fill>
              <SolidColorBrush Color="{StaticResource Color_RectButtonBackground}" />
            </Shape.Fill>
            <Shape.Stroke>
              <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
            </Shape.Stroke>
          </Rectangle>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter TargetName="Rect" Property="Shape.StrokeThickness" Value="2" />
            <Setter TargetName="Rect" Property="Shape.Stroke" Value="{StaticResource SolidColorBrush_Background_Stroke_mo}" />
          </Trigger>
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="Rect" Property="Shape.Fill" Value="{StaticResource SolidColorBrush_FillFull}" />
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="Rect" Property="Shape.Fill" Value="{StaticResource SolidColorBrush_RectButtonBackground}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="Button_Style" TargetType="{x:Type Button}">
        <Setter Property="Template" Value="{StaticResource Button_Template}" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Label_Main}" />
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush_Disable}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="Rectangle_InfoBG_Style" TargetType="{x:Type Rectangle}">
        <Setter Property="Rectangle.RadiusX" Value="5" />
        <Setter Property="Rectangle.RadiusY" Value="5" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Fill" Value="{StaticResource SolidColorBrush_RectButtonBackground}" />
        <Setter Property="Stroke" Value="{StaticResource SolidColorBrush_Background_Stroke}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Rectangle Grid.RowSpan="2">
      <Shape.Fill>
        <SolidColorBrush Color="{StaticResource Color_Background}" />
      </Shape.Fill>
      <Shape.Stroke>
        <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
      </Shape.Stroke>
    </Rectangle>
    <Grid Row="0" MouseDown="Grid_Title_MouseDown">
      <Rectangle>
        <Shape.Fill>
          <SolidColorBrush Color="{StaticResource Color_RectButtonBackground}" />
        </Shape.Fill>
        <Shape.Stroke>
          <SolidColorBrush Color="{StaticResource Color_RectButtonBackground_Stroke}" />
        </Shape.Stroke>
      </Rectangle>
      <Label Content="{DynamicResource Label_Title_FirmwareUpdateWindow}" HorizontalAlignment="Center" Margin="0,0,0,0" Style="{StaticResource Label_WindowTitle_Style}" />
      <Button Name="Btn_Close" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Button_Close_Style}" Click="Btn_Close_Click" />
    </Grid>
    <Grid Name="Grid_FWUpdate" Row="1" Margin="0,20,0,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="160" />
        <RowDefinition Height="30" />
        <RowDefinition Height="200" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="50,0,50,0">
        <Rectangle Style="{StaticResource Rectangle_InfoBG_Style}" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="4*" />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Content="{DynamicResource Label_DeviceFirmwareInfoTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Style="{StaticResource Label_Sub_Style}" />
          <Grid Row="1">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="1" Content="TX" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Grid.Row="0" Grid.Column="2" Content="RX" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Label_ModelName}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Label_FWVersion}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_DevTxName" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_DevTxFwVer" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_DevRxName" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_DevRxFwVer" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
          </Grid>
        </Grid>
      </Grid>
      <Grid Row="1">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Fill="#D6E4FF" Data="M0,0 L20,20 L40,0" />
        </StackPanel>
      </Grid>
      <Grid Row="2" Margin="50,0,50,0">
        <Rectangle Style="{StaticResource Rectangle_InfoBG_Style}" />
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="4*" />
          </Grid.RowDefinitions>
          <Label Content="{DynamicResource Label_SelectedFirmwareInfoTitle}" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" Style="{StaticResource Label_Sub_Style}" />
          <Button Name="Button_SelectFile" Grid.Row="0" Width="100" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Content="Select File" Style="{StaticResource Button_Style}" Visibility="Collapsed" Click="Button_SelectFile_Click" />
          <Grid Row="1">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource Label_FWFileName}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource Label_FWType}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource Label_ModelName}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource Label_FWVersion}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_BinName" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_BinType" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_BinDeviceName" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
            <Label Name="Label_BinFwVer" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" />
          </Grid>
        </Grid>
      </Grid>
      <Grid Row="3" Margin="0,20,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="60" />
          <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
          </Grid.RowDefinitions>
          <Grid Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="270" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ProgressBar Name="PgBar" Grid.Column="1" Width="260" Height="25" />
            <Label Name="Label_Percentage" Grid.Column="2" Content="0%" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Grid>
          <Grid Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="270" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Label_Status" Grid.Column="1" Content="" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Label_Sub_Style}" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
          </Grid>
        </Grid>
        <Button Name="Button_Update" Grid.Row="1" Width="100" Height="25" VerticalAlignment="Center" Content="{DynamicResource Button_Update}" IsEnabled="False" Style="{StaticResource Button_Style}" Click="Button_Update_Click" />
        <Button Name="Button_Done" Grid.Row="1" Width="100" Height="25" VerticalAlignment="Center" Content="{DynamicResource Button_FWWindowClose}" Visibility="Hidden" Style="{StaticResource Button_Style}" Click="Btn_Close_Click" />
        <Button Name="Button_Test" Grid.Row="1" Width="100" Height="25" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Test" Style="{StaticResource Button_Style}" Visibility="Hidden" Click="Button_Test_Click" />
      </Grid>
    </Grid>
    <Grid Name="Grid_UpdateWarning" Row="1" Margin="70,70,70,140" Visibility="Hidden">
      <Rectangle RadiusX="5" RadiusY="5" StrokeThickness="3">
        <Shape.Fill>
          <SolidColorBrush Color="{StaticResource Color_Background}" />
        </Shape.Fill>
        <Shape.Stroke>
          <SolidColorBrush Color="{StaticResource Color_Background_Stroke}" />
        </Shape.Stroke>
      </Rectangle>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50" />
          <RowDefinition />
          <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid Row="0">
          <Label Grid.Row="0" Content="{DynamicResource Label_UpdateWarningTitle}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" Style="{StaticResource Label_Main_Style}" />
        </Grid>
        <Grid Row="1" Margin="80,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Label Grid.Row="0" Content="{DynamicResource Label_UpdateWarningContent1}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="1" Content="{DynamicResource Label_UpdateWarningContent2}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="2" Content="{DynamicResource Label_UpdateWarningContent3}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" />
          <Label Grid.Row="3" Content="{DynamicResource Label_UpdateWarningContent4}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" />
        </Grid>
        <Grid Row="2">
          <Label Content="{DynamicResource Label_UpdateWarningWaiting}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Style="{StaticResource Label_Main_Style}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>